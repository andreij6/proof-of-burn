// Mirrors the real CMC candid (rs/nns/cmc/cmc.did) exactly — block_index is
// nat64, not nat (the CMC's decoder traps on nat; see proposal 142135).
type NotifyTopUpArgs = record {
  canister_id : principal;
  block_index : nat64;
};
type NotifyError = variant {
  Refunded : record { block_index : opt nat64; reason : text };
  Processing;
  TransactionTooOld : nat64;
  InvalidTransaction : text;
  Other : record { error_code : nat64; error_message : text };
};
type NotifyTopUpResult = variant {
  Ok : nat;
  Err : NotifyError;
};

type AuditLogEntry = record {
  user : principal;
  amount_e8s : nat64;
  proposal_id : nat64;
  timestamp : nat64;
  event_type : text;
};
type BalanceResult = variant { Ok : nat64; Err : text };
type Commitment = record {
  // Block index of the CMC ledger transfer performed in Phase A of
  // `burn_to_cycles`. Stored so a retry after a failed `notify_top_up`
  // skips the transfer and goes straight to notifying the CMC.
  // `None` until Phase A has succeeded.
  cmc_block_index : opt nat64;
  treasury_block : opt nat64;
  frontend_cmc_block : opt nat64;
  stance : Stance;
  status : CommitmentStatus;
  "principal" : principal;
  subaccount : blob;
  created_at : nat64;
  amount_e8s : nat64;
  proposal_id : nat64;
  settled_at : opt nat64;
};
type CommitmentStatus = variant {
  Burned;
  ThresholdMet;
  StuckFunds;
  FailedBurn;
  FailedRefund;
  Returned;
  Pending;
};
type Config = record {
  default_threshold : nat64;
  // True when the canister was initialised against a local dev network
  // (detected from the owner's principal or ledger canister id at init).
  // Gating the NNS mock fallback on this flag — not re-deriving environment
  // per call — is what prevents the F-101/F-102 mainnet bypass.
  is_local : bool;
  admins : vec principal;
  ledger_canister_id : principal;
  ai_price_e8s : nat64;
  primary_neuron_id : nat64;
  // Frontend canister topped up with the 25% cycles share (PB-125).
  frontend_canister_id : opt principal;
  pool_initiation_fee_e8s : nat64;
  // Local-only ckBTC/ckETH/ckUSDC test-ledger overrides (mainnet ledgers hard-pinned).
  ckbtc_ledger_canister_id : opt principal;
  cketh_ledger_canister_id : opt principal;
  ckusdc_ledger_canister_id : opt principal;
  ckusdt_ledger_canister_id : opt principal;
  // Admin overrides for per-token minimum upvotes (smallest units); absent
  // values fall back to value-aligned (~$1) defaults.
  min_upvote_icp_e8s : opt nat64;
  min_upvote_ckbtc_e8s : opt nat64;
  min_upvote_cketh_wei : opt nat64;
  // ── Lossless staking (3 fixed tiers: 6mo / 1y / 2y) ──
  min_stake_e8s : nat64;
  min_unstake_e8s : nat64;
  maturity_threshold_e8s : nat64;
  // ── Lossless lottery ──
  lottery_tickets_per_day : nat64;
};
type EligibilityInfo = record {
  holdings_e8s : nat64;
  tier : nat8;
  following : bool;
  authenticated : bool;
  has_committed : bool;
};
// Cached public stats for the community leader neuron (voting power, dissolve
// delay, stake). updated_at == 0 means not yet fetched from the NNS.
type LeaderNeuronInfo = record {
  neuron_id : nat64;
  voting_power : nat64;
  dissolve_delay_seconds : nat64;
  stake_e8s : nat64;
  updated_at : nat64;
};
// App-wide totals used by the global stats strip in the UI.
// - `tvl_e8s`: sum of `total_committed_e8s` over all proposals whose status
// is `open` or `met` (i.e. escrow currently locked).
// - `total_burned_e8s`: cumulative ICP burned through this app, summed over
// every `VoteRecord` (the canonical burn ledger).
// - `votes_cast`: count of distinct NNS proposals the app has voted on,
// derived from `VOTES.len()`.
type GlobalStats = record {
  votes_cast : nat64;
  tvl_e8s : nat64;
  total_burned_e8s : nat64;
  pending_burn_e8s : nat64;
  followers_count : nat64;
};
type PoolStatus = variant {
  Draft;
  Active;
  Inactive;
};
type PoolNeuron = record {
  neuron_id : nat64;
  registered_by : principal;
  voting_power : nat64;
  status : PoolStatus;
  created_at : nat64;
  activated_at : opt nat64;
  treasury_block : opt nat64;
  backend_cmc_block : opt nat64;
  frontend_cmc_block : opt nat64;
};
type ActivePoolNeuron = record {
  neuron_id : nat64;
  voting_power : nat64;
  registered_by : principal;
  rank : nat32;
};
type PoolInfo = record {
  total_pool_voting_power : nat64;
  active_count : nat64;
  active_neurons : vec ActivePoolNeuron;
};
type InitPayload = record {
  default_threshold_e8s : nat64;
  owner : principal;
  ai_price_e8s : nat64;
  primary_neuron_id : nat64;
  // Optional explicit ledger canister id. Absent → derived from is_local
  // (local test ledger vs mainnet ICP ledger).
  ledger_canister_id : opt principal;
};
type LedgerAccount = record { owner : principal; subaccount : opt blob };
// Live NNS follow status of a platform-owned neuron (admin diagnostic).
type NeuronFollowStatus = record {
  label : text;
  neuron_id : nat64;
  follows_primary : bool;
  topics_following_primary : vec int32;
  // Live neuron stake + uncollected (unharvested) maturity, straight from
  // NNS governance. Tier neurons auto-harvest past the maturity threshold.
  stake_e8s : nat64;
  maturity_e8s : nat64;
  error : opt text;
};
type Proposal = record {
  id : nat64;
  status : text;
  nns_proposal_id : opt nat64;
  reject_pot_e8s : nat64;
  title : text;
  summary : text;
  deadline : nat64;
  adopt_pot_e8s : nat64;
  threshold_e8s : nat64;
  total_burned_e8s : opt nat64;
  vote_executed_at : opt nat64;
  category : text;
  total_committed_e8s : nat64;
  // Stance of the first commit — tie-breaker if the pots end equal (PB-123).
  first_stance : opt Stance;
  pool_distributed : bool;
  // Lossless-staking vote weight per side: joins the balance of power that
  // decides the NNS vote direction; never counts toward the burn threshold.
  lossless_adopt_e8s : nat64;
  lossless_reject_e8s : nat64;
};
type Result = variant { Ok; Err : text };
type IdeaIdResult = variant { Ok : nat64; Err : text };
type Stance = variant { Reject; Adopt };
// Tokens accepted for idea upvotes. On mainnet ckBTC/ckETH use their
// canonical ledger canisters; locally they use admin-configured test ledgers.
type IdeaToken = variant { ICP; CkBTC; CkETH };
// Ideas are implicitly active while stored — the sweep DELETES ideas that go
// 30 days without an upvote, so no expired state is ever returned.
type Idea = record {
  id : nat64;
  poster : principal;
  title : text;
  description : text;
  detail : text;
  created_at : nat64;
  // Timestamp of the most recent upvote (== created_at until the first one).
  // The idea is deleted 30 days after this with no further upvotes.
  last_upvote_at : nat64;
  upvote_count : nat64;
  // Detail-view opens by signed-in users (drives "most viewed" sorting).
  views : nat64;
  total_icp_e8s : nat64;
  total_ckbtc_e8s : nat64;
  total_cketh_wei : nat64;
};
type FeatureFlag = record { key : text; enabled : bool };
type IdeaBoardInfo = record {
  enabled : bool;
  icp_ledger : principal;
  ckbtc_ledger : principal;
  cketh_ledger : principal;
  // Per-token minimums are value-aligned (~$1 equivalent) via exchange rates.
  min_upvote_icp_e8s : nat64;
  min_upvote_ckbtc_e8s : nat64;
  min_upvote_cketh_wei : nat64;
  fee_icp_e8s : nat64;
  fee_ckbtc_sats : nat64;
  fee_cketh_wei : nat64;
  expiry_nanos : nat64;
  // Flat fee (ICP e8s) to post an idea; 100% to the treasury.
  post_fee_e8s : nat64;
};
// Admin-curated, fundable project (Community R&D "Projects" tab). Funding
// goes 100% to the protocol treasury. A per-token goal of 0 = not seeking it.
type Project = record {
  id : nat64;
  title : text;
  description : text;
  detail : text;
  created_at : nat64;
  goal_icp_e8s : nat64;
  goal_ckbtc_e8s : nat64;
  goal_cketh_wei : nat64;
  raised_icp_e8s : nat64;
  raised_ckbtc_e8s : nat64;
  raised_cketh_wei : nat64;
  funding_count : nat64;
  accept_icp : bool;
  accept_ckbtc : bool;
  accept_cketh : bool;
};
// ── Lossless Voting (pooled staking, 3 fixed-term tiers) ──
// Terms: SixMonths = 15,778,800 s; OneYear = 31,557,600 s; TwoYears =
// 63,115,200 s. Voting weight and daily lottery tickets scale with the term:
// 1× / 2× / 4×.
type StakeTier = variant { SixMonths; OneYear; TwoYears };
type StakingBootstrap = variant { NotStarted; Claimed; DelaySet; Ready };
type MaturityDisbursement = record {
  amount_e8s : nat64;
  initiated_at : nat64;
  // When the minted ICP should arrive in the yield inbox (~+7 days).
  expected_at : nat64;
};
type UserTierStake = record {
  tier : StakeTier;
  amount_e8s : nat64;
  // amount × the tier's multiplier — this position's voting power.
  weight_e8s : nat64;
  staked_at : nat64;
  last_action_at : nat64;
};
type UserStakeInfo = record {
  tiers : vec UserTierStake;
  total_staked_e8s : nat64;
  total_weight_e8s : nat64;
};
type TierPoolInfo = record {
  tier : StakeTier;
  dissolve_delay_secs : nat64;
  weight_multiplier : nat64;
  // Daily lottery tickets a staker in this tier collects.
  daily_tickets : nat64;
  neuron_id : opt nat64;
  total_staked_e8s : nat64;
  staker_count : nat64;
  bootstrap : StakingBootstrap;
  pending_refresh_e8s : nat64;
  pending_maturity : vec MaturityDisbursement;
  total_yield_e8s : nat64;
};
type StakingPoolInfo = record {
  pools : vec TierPoolInfo;
  total_staked_e8s : nat64;
  min_stake_e8s : nat64;
  min_unstake_e8s : nat64;
  // Lifetime yield across all tiers (split 50/50 lottery pot / treasury).
  total_yield_e8s : nat64;
};
type UnstakeStatus = variant { SplitDone; Dissolving; Disbursed; Merged };
type PendingUnstake = record {
  id : nat64;
  user : principal;
  tier : StakeTier;
  amount_e8s : nat64;
  split_neuron_id : nat64;
  status : UnstakeStatus;
  created_at : nat64;
  // Nanosecond timestamp when the split neuron finishes dissolving (the
  // tier's full term).
  dissolve_eta : nat64;
  disburse_block : opt nat64;
  // Tier the dissolving neuron was merged back into (status == Merged).
  merged_into : opt StakeTier;
  // What the split child holds: the exact requested amount since the treasury
  // began fronting the split fee; absent on legacy unstakes (amount − 0.0001).
  child_e8s : opt nat64;
  // Treasury fee reimbursement (0.0003 ICP) — makes the cycle zero-loss.
  fee_refund_block : opt nat64;
  settled_at : opt nat64;
};
type LosslessVote = record {
  proposal_id : nat64;
  "principal" : principal;
  stance : Stance;
  // Stake snapshot at cast time.
  weight_e8s : nat64;
  cast_at : nat64;
};
type YieldStatus = variant { InProgress; Done };
// One drain of the shared yield inbox: 50% → lottery prize pot, 50% → treasury.
type YieldDistribution = record {
  id : nat64;
  amount_e8s : nat64;
  lottery_amount_e8s : nat64;
  treasury_amount_e8s : nat64;
  lottery_block : opt nat64;
  treasury_block : opt nat64;
  status : YieldStatus;
  created_at : nat64;
  completed_at : opt nat64;
};
type UnstakeResult = variant { Ok : nat64; Err : text };
// ── Lossless Lottery (Powerball-style) ──
type DrawStatus = variant { PayoutPending; Done };
// One drawing. `winning_ticket` is a random index in
// [0, odds_denominator); a ticket wins when it lands below `total_tickets`.
type LotteryDraw = record {
  id : nat64;
  round : nat64;
  drawn_at : nat64;
  total_tickets : nat64;
  // Drawings only run when the pot holds at least min_pot_e8s (50 ICP) —
  // checked at the scheduled moment; otherwise the drawing rolls over.
  min_pot_e8s : nat64;
  pot_e8s : nat64;
  winning_ticket : opt nat64;
  winner : opt principal;
  // Gross 80% prize; the winner nets this minus one ledger fee.
  prize_e8s : nat64;
  payout_block : opt nat64;
  status : DrawStatus;
};
type LotteryInfo = record {
  enabled : bool;
  round : nat64;
  // Nanosecond timestamp of the next draw (0 = not yet scheduled).
  next_draw_at : nat64;
  total_tickets : nat64;
  my_tickets : nat64;
  claimed_today : bool;
  // Whether the caller holds any stake (staking gates lottery eligibility).
  eligible : bool;
  // True when the caller is an admin — admins never hold tickets.
  admin_excluded : bool;
  // Base daily grant for a 6-month staker (admin-tunable); tiers scale it
  // 1×/2×/4× (5/10/20 at the default base of 5).
  tickets_per_day : nat64;
  // The caller's actual daily grant across their staked tiers (0 = not staked).
  my_daily_tickets : nat64;
  // Drawings only run when the pot holds at least min_pot_e8s (50 ICP) —
  // checked at the scheduled moment; otherwise the drawing rolls over.
  min_pot_e8s : nat64;
  pot_e8s : nat64;
  // Powerball jackpot odds: 1 in 292,201,338 per ticket per draw.
  odds_denominator : nat64;
  draws_held : nat64;
  last_winner : opt principal;
  last_win_at : opt nat64;
  total_paid_e8s : nat64;
};
type PayoutType = variant { LotteryWin; UnstakeDisbursement; IdeaUpvoteShare; CommitmentRefund; PoolReward; EarlyAdopterYield };
// One payout the site made to a user, in the token's smallest unit.
type Payout = record {
  id : nat64;
  user : principal;
  payout_type : PayoutType;
  token : IdeaToken;
  amount : nat64;
  created_at : nat64;
  // Source record id (draw id, unstake id, upvote id, proposal id).
  ref_id : nat64;
};
type ClaimResult = variant { Ok : nat64; Err : text };
type TxDirection = variant { In; Out };
// One Profile transaction row — spends (Out: commits, idea posts, pool fees,
// stake lockups, upvotes, fundings) and payouts (In) unified, newest first.
type TransactionRecord = record {
  direction : TxDirection;
  kind : text;
  token : IdeaToken;
  amount : nat64;
  timestamp : nat64;
  ref_id : nat64;
};

// ── Dapp Explorer (paid directory listings) ──
// Tokens accepted for Explorer listing fees ($1/day). On mainnet ckBTC/
// ckETH/ckUSDC use their canonical ledgers; locally, admin-configured test
// ledgers.
type ExplorerToken = variant { ICP; CkBTC; CkETH; CkUSDC; CkUSDT };
type DappStatus = variant { Pending; Approved };
type DappListing = record {
  id : nat64;
  submitter : principal;
  name : text;
  url : text;
  description : text;
  // True for paid community submissions (badged in the UI); false for
  // admin-curated listings.
  community : bool;
  status : DappStatus;
  created_at : nat64;
  approved_at : opt nat64;
  // null = permanent (admin listings). Community listings expire `days`
  // after approval and are then deleted by the sweep.
  expires_at : opt nat64;
  days : nat64;
  token : opt ExplorerToken;
  // Amount paid in `token`'s smallest unit (0 for admin listings).
  amount_paid : nat64;
};
// A locked price for one caller: deposit `amount` (+ one ledger fee) on the
// token's ledger, then call submit_dapp before `expires_at`.
type ExplorerQuote = record {
  token : ExplorerToken;
  days : nat64;
  amount : nat64;
  // USD value of one whole token at quote time (e8s).
  rate_usd_e8s : nat64;
  usd_total_e8s : nat64;
  created_at : nat64;
  expires_at : nat64;
};
type ExplorerInfo = record {
  enabled : bool;
  icp_ledger : principal;
  ckbtc_ledger : principal;
  cketh_ledger : principal;
  ckusdc_ledger : principal;
  ckusdt_ledger : principal;
  fee_icp_e8s : nat64;
  fee_ckbtc_sats : nat64;
  fee_cketh_wei : nat64;
  fee_ckusdc_micro : nat64;
  fee_ckusdt_micro : nat64;
  price_per_day_usd_e8s : nat64;
  min_days : nat64;
  max_days : nat64;
  quote_ttl_nanos : nat64;
};
type ExplorerQuoteResult = variant { Ok : ExplorerQuote; Err : text };
// Which pay-first deposit escrow to reclaim from.
type EscrowKind = variant { Explorer; Arcade; EarlyAdopter };

// ── Arcade (skill games, participation-gated) ──
// Palette indices for the low-poly golfer (defaults are all 0).
type ArcadeCharacter = record { hair : nat8; skin : nat8; outfit : nat8 };
type ArcadeInfo = record {
  enabled : bool;
  // Caller may finish full rounds + submit scores (stake or vote ≤30 days old).
  full_access : bool;
  has_stake : bool;
  voted_recently : bool;
  // $1.00 in USD e8s — convert with get_arcade_customize_quote.
  customize_fee_usd_e8s : nat64;
  my_character : opt ArcadeCharacter;
  hair_options : nat8;
  skin_options : nat8;
  outfit_options : nat8;
};
type ArcadeLeaderboardRow = record {
  rank : nat32;
  player : principal;
  strokes : nat32;
  millis : nat64;
  submitted_at : nat64;
};
type RankResult = variant { Ok : nat32; Err : text };
// One Mini Golf Gold hole as an admin-editable voxel layout: a 22×14
// row-major tile grid (0 void, 1 grass, 2 wall, 3 sand, 4 water, 5..8 slope
// N/S/E/W, 9 post), tee/cup cell coords, par, optional windmill bars.
type ArcadeBarDef = record { cx : nat8; cy : nat8; len_cells : nat8; speed_mrad : nat32 };
type ArcadeHoleDef = record {
  name : text;
  par : nat8;
  w : nat8;
  h : nat8;
  cells : vec nat8;
  tee_x : nat8;
  tee_y : nat8;
  cup_x : nat8;
  cup_y : nat8;
  bars : vec ArcadeBarDef;
};
type ArcadeCourseEntry = record { index : nat8; hole : ArcadeHoleDef };
// ── Early Adopters (permanent stake — NO unstake exists, by design) ──
type EarlyAdopterInfo = record {
  enabled : bool;
  // True once any month's yield has reached close_threshold_e8s (2,000 ICP)
  // — permanent; new members rejected, existing early adopters may still top up.
  membership_closed : bool;
  close_threshold_e8s : nat64;
  // Months yielding under this (500 ICP) are restaked into the neuron.
  restake_threshold_e8s : nat64;
  total_restaked_e8s : nat64;
  // The early adopter neuron; once bootstrapped it follows the primary voting
  // neuron on all topics and votes on every NNS proposal the leader does.
  neuron_id : opt nat64;
  follows_primary_neuron : bool;
  primary_neuron_id : nat64;
  min_stake_e8s : nat64;
  // The treasury's monthly cut: the first 1,000 ICP of each month's yield.
  treasury_cut_e8s : nat64;
  // Minimum pot (100 ICP) before an even split happens; below it rolls over.
  min_distribution_e8s : nat64;
  period_nanos : nat64;
  early_adopter_count : nat64;
  total_staked_e8s : nat64;
  rollover_e8s : nat64;
  // Live share-pool balance (unclaimed shares + rollover).
  share_pool_e8s : nat64;
  total_yield_e8s : nat64;
  total_distributed_e8s : nat64;
  next_distribution_at : nat64;
  my_staked_e8s : nat64;
  my_claimable_e8s : nat64;
  fee_e8s : nat64;
};
// One row of the public early adopter roster.
type EarlyAdopterPublic = record {
  user : principal;
  staked_e8s : nat64;
  joined_at : nat64;
  is_admin : bool;
};
// One monthly settlement — drives the yield + share-pool charts.
type EarlyAdopterRound = record {
  month : nat64;
  settled_at : nat64;
  yield_e8s : nat64;
  treasury_e8s : nat64;
  // Allocated to early adopters, proportional to staked ICP.
  distributed_e8s : nat64;
  // Yield restaked into the neuron (months under 500 ICP).
  restaked_e8s : nat64;
  early_adopter_count : nat64;
  // Unclaimed shares from the previous round forfeited to the treasury.
  expired_e8s : nat64;
  rollover_after_e8s : nat64;
  share_pool_after_e8s : nat64;
};

type Vote = variant { No; Yes; Abstain };
type VoteRecord = record {
  vote : Vote;
  proposal_id : nat64;
  nns_outcome : opt text;
  decided_at : nat64;
  icp_burned_e8s : nat64;
};
service : (InitPayload) -> {
  add_admin : (principal) -> (Result);
  // Admin: change the default voting threshold (e8s) at any time. Updates the
  // config default for future proposals AND re-applies + recomputes status for
  // all currently open/met proposals. Rejects values below MIN_COMMIT (1 ICP).
  admin_set_default_threshold : (nat64) -> (Result);
  // Admin: set the frontend canister id that receives the 25% cycles share.
  admin_set_frontend_canister : (principal) -> (Result);
  admin_set_pool_fee : (nat64) -> (Result);
  admin_set_proposal_deadline : (nat64, nat64) -> (Result);
  admin_trigger_sweep : () -> (Result);
  // Admin: withdraw ICP from the treasury subaccount to a destination principal.
  // Guarded by the 15 ICP treasury floor unless override_floor = true.
  admin_withdraw_treasury : (principal, nat64, bool) -> (Result);
  // Withdraw any supported token from the treasury account (floor applies to ICP).
  admin_withdraw_treasury_token : (ExplorerToken, principal, nat64, bool) -> (Result);
  // Allocate treasury ICP into a tier pool neuron / the early-adopter neuron.
  admin_fund_tier_neuron : (StakeTier, nat64, bool) -> (Result);
  admin_fund_early_adopter_neuron : (nat64, bool) -> (Result);
  // Frontend canister's live cycle balance (backend must control the frontend).
  admin_get_frontend_cycles : () -> (variant { Ok : nat64; Err : text });
  commit : (nat64, Stance, nat64) -> (Result);
  create_pool_draft : (nat64) -> (Result);
  cancel_pool_draft : (nat64) -> (Result);
  finalize_pool_registration : (nat64) -> (Result);
  unregister_leader_neuron : (nat64) -> (Result);
  distribute_pool_rewards : (nat64) -> (Result);
  // Top up an existing commitment with additional ICP. No protocol fee is
  // charged — only the deposit ledger fee (0.0001 ICP). The proposal must
  // still be open/met and >1 hour from deadline.
  add_to_commitment : (nat64, nat64) -> (Result);
  // Local-dev faucet — sends 100 ICP from the canister's own account to the caller.
  // Rejected on mainnet (ledger canister ID check). Never callable by anonymous.
  dev_faucet : () -> (Result);
  // Local-dev: insert an Active pool neuron with an explicit voting power, used
  // to seed mock pool members for UI testing. Rejected on mainnet.
  dev_seed_pool_neuron : (nat64, nat64) -> (Result);
  // Returns a page of audit log entries. offset + limit are capped at 10,000
  // to prevent a single query from exhausting cycle budgets.
  get_audit_log : (nat64, nat64) -> (vec AuditLogEntry) query;
  // The caller's ICP deposit address (account identifier, 64-hex) for the
  // default sub-account. Distinct from the principal; used to fund the account.
  get_account_id : () -> (text) query;
  get_caller_principal : () -> (principal) query;
  get_config : () -> (Config) query;
  get_cycle_balance : () -> (nat64) query;
  get_deposit_address : (nat64) -> (LedgerAccount) query;
  get_registration_address : () -> (LedgerAccount) query;
  get_eligibility : () -> (EligibilityInfo) query;
  // App-wide totals: TVL (sum of `total_committed_e8s` over open/met proposals),
  // cumulative ICP burned (sum of `icp_burned_e8s` over all `VoteRecord`s), and
  // the count of distinct NNS proposals this app has cast a vote on.
  // 
  // Pure read over in-memory maps — `O(n)` over proposals + votes. Safe for any
  // reasonable n; documented in the task.
  get_global_stats : () -> (GlobalStats) query;
  get_leader_neuron_info : () -> (LeaderNeuronInfo) query;
  get_my_pool_neuron : () -> (opt PoolNeuron) query;
  get_pool_info : () -> (PoolInfo) query;
  get_my_commitments : () -> (vec Commitment) query;
  get_proposal : (nat64) -> (opt Proposal) query;
  get_treasury_balance : () -> (BalanceResult);
  // The treasury's ledger account — deposit ICP here to fund it directly.
  get_treasury_deposit_address : () -> (LedgerAccount) query;
  // Admin diagnostic: live NNS follow status of every platform-owned neuron.
  admin_check_neuron_following : () -> (vec NeuronFollowStatus);
  list_active_proposals : () -> (vec Proposal) query;
  list_all_proposals : () -> (vec Proposal) query;
  list_vote_history : () -> (vec VoteRecord) query;
  refund_registration : () -> (Result);
  // Self-attested follow (Option C): records the caller as following the leader
  // neuron without on-chain ownership verification. Conviction = the ICP burn.
  confirm_follow : () -> (Result);
  notify_top_up : (NotifyTopUpArgs) -> (NotifyTopUpResult);
  remove_admin : (principal) -> (Result);
  wallet_receive : () -> (Result);
  // ── Feature flags ──
  // All flags (known defaults merged with admin overrides). Public query so
  // the UI can hide gated features for anonymous viewers.
  list_feature_flags : () -> (vec FeatureFlag) query;
  // Admin: enable/disable a feature completely (kill switch).
  admin_set_feature_flag : (text, bool) -> (Result);
  // ── Idea Board ──
  // The flag + per-token ledgers + minimum upvotes, in one query.
  get_idea_board_info : () -> (IdeaBoardInfo) query;
  // All live ideas, newest first (time-expired ideas omitted).
  list_ideas : () -> (vec Idea) query;
  // Post a new idea (title, description, detail). Costs the 1 ICP post fee:
  // fund get_idea_post_deposit_address with post_fee + 0.0001 ICP first.
  post_idea : (text, text, text) -> (IdeaIdResult);
  // The caller's deposit subaccount for the idea-posting fee.
  get_idea_post_deposit_address : () -> (LedgerAccount) query;
  // The caller's deposit subaccount for upvoting an idea. Fund it on the
  // chosen token's ledger with amount + 2×fee, then call upvote_idea.
  get_idea_deposit_address : (nat64) -> (LedgerAccount) query;
  // Spend deposited funds to upvote: 75% → treasury, 25% → idea poster.
  upvote_idea : (nat64, IdeaToken, nat64) -> (Result);
  // Count a detail-view open (signed-in users; drives "most viewed" sorting).
  record_idea_view : (nat64) -> (Result);
  // Admin: point ckBTC/ckETH at locally deployed test ledgers (local only —
  // mainnet token ledgers are hard-pinned to the canonical canisters).
  admin_set_token_ledger : (IdeaToken, principal) -> (Result);
  // Admin: retune a token's minimum upvote as exchange rates drift.
  admin_set_min_upvote : (IdeaToken, nat64) -> (Result);
  // Local-dev faucet: 100 ICP / 0.1 ckBTC / 1 ckETH to the caller.
  dev_faucet_token : (IdeaToken) -> (Result);
  // ── Projects (Community R&D, admin-curated) ──
  // All projects, newest first.
  list_projects : () -> (vec Project) query;
  // Admin: add a fundable project (title, description, detail, goal ICP e8s,
  // goal ckBTC sats, goal ckETH wei, accept ICP, accept ckBTC, accept ckETH).
  admin_add_project : (text, text, text, nat64, nat64, nat64, bool, bool, bool) -> (IdeaIdResult);
  // Admin: update a project's details, funding goals, and cryptocurrency toggles.
  admin_update_project : (nat64, text, text, text, nat64, nat64, nat64, bool, bool, bool) -> (Result);
  // Admin: remove a project from the board.
  admin_remove_project : (nat64) -> (Result);
  // Admin: remove an idea from the board.
  admin_remove_idea : (nat64) -> (Result);
  // The caller's deposit subaccount for funding a project. Fund it on the
  // chosen token's ledger with amount + fee, then call fund_project.
  get_project_deposit_address : (nat64) -> (LedgerAccount) query;
  // Spend deposited funds on a project: 100% → protocol treasury.
  fund_project : (nat64, IdeaToken, nat64) -> (Result);
  // ── Lossless Voting (pooled staking, 3 fixed-term tiers) ──
  // The caller's stake-escrow subaccount. Fund it with EXACTLY the stake
  // amount, then call stake(amount, tier) — the treasury covers every
  // transfer fee in the cycle (zero-loss).
  get_stake_deposit_address : () -> (LedgerAccount) query;
  // Stake deposited ICP into the tier's pooled neuron (a tier's first stake
  // must be ≥ 1 ICP — it creates that tier's neuron).
  stake : (nat64, StakeTier) -> (Result);
  // Split + dissolve `amount` out of the tier's pool; ICP lands in the
  // caller's wallet after the tier's full term. Returns the pending-unstake id.
  unstake : (nat64, StakeTier) -> (UnstakeResult);
  // Merge a still-dissolving unstake neuron back into any tier pool (the
  // platform's main neurons are merge targets only, never sources). The
  // child's stake minus 0.0002 ICP of neuron fees resumes earning there.
  merge_unstake : (nat64, StakeTier) -> (Result);
  get_my_stake : () -> (UserStakeInfo) query;
  get_staking_pool_info : () -> (StakingPoolInfo) query;
  list_my_pending_unstakes : () -> (vec PendingUnstake) query;
  // Admin: every user's unstake split-neuron record (dissolving/restaked/disbursed).
  admin_list_pending_unstakes : () -> (vec PendingUnstake) query;
  // Free vote with staked weight × term multiplier (balance of power only —
  // never the burn threshold).
  cast_lossless_vote : (nat64, Stance) -> (Result);
  get_my_lossless_votes : () -> (vec LosslessVote) query;
  list_yield_distributions : () -> (vec YieldDistribution) query;
  // Admin: tune min stake / min unstake / maturity threshold (null =
  // unchanged). Tier dissolve delays are fixed (6mo / 1y / 2y).
  admin_set_staking_config : (opt nat64, opt nat64, opt nat64) -> (Result);
  // Local-dev helpers (rejected on mainnet).
  dev_run_staking_sweep : () -> (Result);
  dev_fast_forward_dissolve : (nat64) -> (Result);
  dev_add_mock_maturity : (nat64, StakeTier) -> (Result);
  // ── Lossless Lottery (Powerball odds & cadence; stakers only) ──
  // Credit today's tickets (once per UTC day). Requires an active stake —
  // the grant is the base × term multiplier summed over staked tiers
  // (5/10/20 per day at the default base). Returns the caller's
  // current-round ticket count.
  claim_daily_tickets : () -> (ClaimResult);
  // Update (not query): reads the live pot balance from the ledger.
  get_lottery_info : () -> (LotteryInfo);
  // Most recent drawings, newest first (capped at 50).
  list_lottery_draws : () -> (vec LotteryDraw) query;
  // The caller's payout history, newest first.
  get_my_payouts : () -> (vec Payout) query;
  // The caller's unified transaction history (spends + payouts), newest first.
  get_my_transactions : () -> (vec TransactionRecord) query;
  // Admin: tune how many tickets a daily login credits.
  admin_set_lottery_config : (opt nat64) -> (Result);
  // Local-dev: hold a drawing now; force_win rigs ticket 0 to win.
  dev_run_lottery_draw : (bool) -> (Result);
  // The last 10 winning drawings, newest first.
  list_recent_winners : () -> (vec LotteryDraw) query;
  // The lottery prize-pot account — transfer ICP here to sweeten the pot.
  get_lottery_pot_address : () -> (LedgerAccount) query;
  // Local-dev: promote the caller to admin (require_local_dev — never
  // available in production).
  dev_become_admin : () -> (Result);
  // Local-dev: wipe + reseed the mock proposals (returns the count) so you
  // can vote again. Clears their commitments and staked votes.
  dev_reset_proposals : () -> (variant { Ok : nat64; Err : text });
  // Local-dev: seed mock payout history for the caller (no-op if non-empty).
  dev_seed_payouts : () -> (Result);
  // ── Dapp Explorer (paid directory listings) ──
  // The flag + per-token ledgers/fees + pricing constants, in one query.
  get_explorer_info : () -> (ExplorerInfo) query;
  // All live (approved, unexpired) listings: admin-curated first, then
  // community listings in approval order.
  list_dapps : () -> (vec DappListing) query;
  // The caller's own submissions in every state (shows pending approvals).
  list_my_dapp_submissions : () -> (vec DappListing) query;
  // Admin: the approval queue, oldest first.
  list_pending_dapps : () -> (vec DappListing) query;
  // Price `days` of visibility in `token` at the live USD rate ($1/day via
  // the XRC on mainnet) and lock that price for the caller for 15 minutes.
  get_explorer_quote : (ExplorerToken, nat64) -> (ExplorerQuoteResult);
  // The caller's deposit subaccount for listing fees. Fund it on the quoted
  // token's ledger with quote.amount + one fee, then call submit_dapp.
  get_explorer_deposit_address : () -> (LedgerAccount) query;
  // Submit a community listing (needs a fresh matching quote + the funded
  // deposit). Payment goes to the treasury; the listing stays hidden until
  // an admin approves it. Rejection refunds (minus one ledger fee).
  submit_dapp : (text, text, text, ExplorerToken, nat64) -> (IdeaIdResult);
  // Admin: approve a pending listing — its paid window starts now.
  admin_approve_dapp : (nat64) -> (Result);
  // Admin: reject a pending listing — refunds from the treasury, then deletes.
  admin_reject_dapp : (nat64) -> (Result);
  // Admin: add a permanent curated listing (no payment, no badge, no expiry).
  admin_add_dapp : (text, text, text) -> (IdeaIdResult);
  // Admin: remove any listing outright (no refund).
  admin_remove_dapp : (nat64) -> (Result);
  // Admin: point Explorer tokens at locally deployed test ledgers (local only).
  admin_set_explorer_ledger : (ExplorerToken, principal) -> (Result);
  // Admin: seed/override a token's USD rate (e8s per whole token) — the only
  // rate knob on local networks (no XRC there).
  admin_set_usd_rate : (ExplorerToken, nat64) -> (Result);
  // Withdraw the caller's remaining balance from one of their pay-first
  // deposit subaccounts (stranded by an expired quote, quota, etc.).
  // Returns the reclaimed amount in the token's smallest unit.
  reclaim_escrow : (EscrowKind, ExplorerToken) -> (ClaimResult);
  // ── Arcade (skill games, participation-gated) ──
  // Flag + caller's access level + character + customization pricing.
  get_arcade_info : () -> (ArcadeInfo) query;
  // The caller's deposit subaccount for arcade fees. Fund it on the ICP
  // ledger with customize_fee + 0.0001 ICP, then call customize_character.
  get_arcade_deposit_address : () -> (LedgerAccount) query;
  // Price the $1 customization in `token` and lock it for 15 minutes.
  get_arcade_customize_quote : (ExplorerToken) -> (ExplorerQuoteResult);
  // Change the golfer's look (hair/skin/outfit palette indices); costs $1,
  // paid to the treasury in any supported token at the quoted rate.
  customize_character : (nat8, nat8, nat8, ExplorerToken) -> (Result);
  // Submit a finished 9-hole round (per-hole strokes + elapsed millis).
  // Requires an active stake or a vote in the last 30 days. Keeps only the
  // caller's best round (fewest strokes, then fastest); returns their rank.
  submit_arcade_score : (text, nat64, vec nat8) -> (RankResult);
  // Top 100 for one game: fewest strokes, fastest time, earliest submission.
  get_arcade_leaderboard : (text) -> (vec ArcadeLeaderboardRow) query;
  // On-chain hole overrides (defaults ship in the frontend; the game merges
  // these over them at load).
  get_arcade_course : () -> (vec ArcadeCourseEntry) query;
  // Admin: replace one hole's voxel layout (0-based index, validated).
  admin_set_arcade_hole : (nat8, ArcadeHoleDef) -> (Result);
  // Admin: drop one hole's override, reverting to the built-in layout.
  admin_reset_arcade_hole : (nat8) -> (Result);
  // ── Early Adopters (permanent stake into the platform's 2-year neuron) ──
  // Program stats + the caller's position (stake, claimable share, deadline).
  get_early_adopter_info : () -> (EarlyAdopterInfo) query;
  // Monthly settlement history, oldest first (chart data).
  list_early_adopter_rounds : () -> (vec EarlyAdopterRound) query;
  // The full early adopter roster, largest stake first. is_admin marks team
  // members (rendered as the FOUNDER tag).
  list_early_adopters : () -> (vec EarlyAdopterPublic) query;
  // The caller's deposit subaccount. Fund with amount + 0.0001 ICP, then
  // call early_adopter_stake.
  get_early_adopter_deposit_address : () -> (LedgerAccount) query;
  // Stake into the early adopter neuron. PERMANENT — there is no unstake
  // method anywhere in this canister, by design.
  early_adopter_stake : (nat64) -> (Result);
  // Claim the caller's monthly share. Unclaimed shares are forfeited to the
  // treasury at the next monthly settlement.
  claim_early_adopter_yield : () -> (ClaimResult);
  // Local-dev: the neuron's yield inbox (send mock yield here).
  get_early_adopter_yield_inbox_address : () -> (LedgerAccount) query;
  // Local-dev: force a settlement now regardless of the period clock.
  dev_run_early_adopter_settlement : () -> (Result);
  // Local-dev: jump the page to a preset state (0 fresh/open, 1 open with
  // members + history + claimable, 2 membership closed). Visual only.
  dev_set_early_adopter_preset : (nat8) -> (Result);
  // ── Social profile ──
  // Set (empty text clears) the caller's X/Twitter handle (no @, 1–15 chars
  // [A-Za-z0-9_]). Used for proposal-sharing social features.
  set_twitter_handle : (text) -> (Result);
  get_my_twitter_handle : () -> (opt text) query;
}
