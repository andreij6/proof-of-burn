};
type CrashStrategy = record {
  id : nat64;
  base_bet_chips : nat64;
  name : text;
  skip_rounds_after_loss : nat64;
  stop : StrategyStop;
  description : text;
  created_at : nat64;
  auto_target_x100 : nat64;
  // Lifetime VP (weight-e8s) won/lost by all pilots running this strategy.
  lifetime_vp_e8s : int;
  builtin : bool;
  author : principal;
  version : nat64;
  max_bet_chips : nat64;
  max_consecutive_losses : nat64;
  on_win : ProgressionRule;
  on_loss : ProgressionRule;
};
type CrashStrategyInput = record {
  on_win_multiply : bool;
  base_bet_chips : nat64;
  name : text;
  skip_rounds_after_loss : nat64;
  description : text;
  auto_target_x100 : nat64;
  stop_loss_vp_x1000 : nat64;
  on_loss_multiply : bool;
  max_bet_chips : nat64;
  on_loss_factor_x100 : nat64;
  max_rounds : nat64;
  max_consecutive_losses : nat64;
  take_profit_vp_x1000 : nat64;
  on_win_factor_x100 : nat64;
};
type CrashVerifyView = record {
  seed_hex : text;
  recomputed_x100 : nat64;
  // seed hashed forward `chain_index` times must equal the terminal h_0.
  chain_verified : bool;
  terminal_hex : text;
  round_id : nat64;
  chain_index : nat64;
};
type DappListing = record {
  id : nat64;
  url : text;
  // Categories this dapp belongs to (subset of `DAPP_CATEGORIES`). Drives
  // the Explorer's category filter; not shown on the grid cards.
  categories : vec text;
  status : DappStatus;
  token : opt IdeaToken;
  submitter : principal;
  // Optional X/Twitter handle (without the leading @), e.g. "ICPSwap".
  // Rendered as a link on the card. None = no handle shown.
  twitter : opt text;
  days : nat64;
  name : text;
  // True for paid community submissions (badged in the UI); false for
  // admin-curated listings.
  community : bool;
  approved_at : opt nat64;
  description : text;
  created_at : nat64;
  // Amount paid in `token`'s smallest unit (0 for admin listings).
  amount_paid : nat64;
  // True if the submitter flagged the dapp as "vibe coded" (built largely
  // with AI assistance). Shown as a badge above the title. Always false for
  // curated/admin and default-seeded listings.
  is_vibe_coded : bool;
  // None = permanent (admin listings). Community listings expire
  // `days` after approval and are then deleted by the sweep.
  expires_at : opt nat64;
};
type DappStatus = variant {
  Approved;
  // Community submission awaiting admin review — never shown publicly.
  Pending;
};
type DifficultyFilter = variant { Any; Easy; Hard; Medium };
type DrawStatus = variant {
  Done;
  // A winner was drawn but the prize transfer hasn't succeeded yet; the
  // 5-minute timer retries until it lands. Tickets are already reset.
  PayoutPending;
};
type EarlyAdopterInfo = record {
  min_stake_e8s : nat64;
  early_adopter_count : nat64;
  // Live share-pool ledger balance (unclaimed shares + rollover).
  share_pool_e8s : nat64;
  // True once any month's yield has reached `close_threshold_e8s` —
  // permanently; new members are rejected, existing ones may top up.
  membership_closed : bool;
  total_restaked_e8s : nat64;
  // Nanosecond timestamp when the next settlement can run.
  next_distribution_at : nat64;
  min_distribution_e8s : nat64;
  total_staked_e8s : nat64;
  fee_e8s : nat64;
  period_nanos : nat64;
  // True once the neuron follows the primary voting neuron on all topics
  // (bootstrap Ready) — it then votes on every NNS proposal the leader does.
  follows_primary_neuron : bool;
  enabled : bool;
  rollover_e8s : nat64;
  close_threshold_e8s : nat64;
  // Months yielding under this are restaked into the neuron.
  restake_threshold_e8s : nat64;
  total_distributed_e8s : nat64;
  treasury_cut_e8s : nat64;
  total_yield_e8s : nat64;
  my_staked_e8s : nat64;
  my_claimable_e8s : nat64;
  primary_neuron_id : nat64;
  // The early adopter neuron (None until the first claim lands).
  neuron_id : opt nat64;
};
// One row of the public early adopter roster.
type EarlyAdopterPublic = record {
  staked_e8s : nat64;
  // True when this early adopter is a platform admin — rendered as the
  // "FOUNDER" tag (the team has its own ICP locked in the same neuron).
  is_admin : bool;
  user : principal;
  joined_at : nat64;
};
// One monthly settlement — drives the yield + share-pool charts.
type EarlyAdopterRound = record {
  early_adopter_count : nat64;
  month : nat64;
  treasury_e8s : nat64;
  // Yield restaked into the neuron (months under 500 ICP).
  restaked_e8s : nat64;
  // Total allocated to early adopters this round (proportional to stake).
  distributed_e8s : nat64;
  // Unclaimed shares from the PREVIOUS round forfeited to the treasury.
  expired_e8s : nat64;
  yield_e8s : nat64;
  // Share-pool balance after this settlement (unclaimed + rollover).
  share_pool_after_e8s : nat64;
  rollover_after_e8s : nat64;
  settled_at : nat64;
};
type EligibilityInfo = record {
  holdings_e8s : nat64;
  tier : nat8;
  following : bool;
  authenticated : bool;
  has_committed : bool;
};
// Which pay-first deposit escrow to reclaim from.
// 
// `Explorer`/`Arcade`/`EarlyAdopter` were the original reclaimable kinds
// (review 2026-06-11). The 2026-06-20 escrow audit found that every other
// pay-first escrow — Featured, Idea-post, Discussion, Stake, Commitment,
// Project — had **no reclaim path at all**, so a deposit that wasn't
// consumed (abandoned, failed a guard, overpaid, or — for Discussion —
// the proposal settled before the comment landed) was permanently
// stranded. All six are now reclaimable here.
// 
// `Commitment` and `Project` are keyed by an id (proposal_id / project_id)
// passed as `reclaim_escrow`'s `key` arg; the other kinds are per-principal
// and ignore `key`. `Commitment`/`Project` refuse to reclaim while an
// in-flight record still claims the escrow (settlement/funding owns it
// then) — see `commitment_in_flight` / `project_funding_in_flight`. That
// keeps a user from clawing back committed/staked principal mid-saga;
// overpayment dust becomes reclaimable once the record reaches a terminal
// state (Commitment `Burned`/`Returned`, or no record at all).
type EscrowKind = variant {
  Stake;
  Explorer;
  Discussion;
  Project;
  Arcade;
  Commitment;
  Featured;
  EarlyAdopter;
  IdeaPost;
};
// Everything the Explorer UI needs in one query.
type ExplorerInfo = record {
  cketh_ledger : principal;
  // Canonical category list the UI offers in the submit dialog + filter.
  available_categories : vec text;
  fee_icp_e8s : nat64;
  max_days : nat64;
  ckusdt_ledger : principal;
  fee_ckusdc_micro : nat64;
  ckusdc_ledger : principal;
  fee_cketh_wei : nat64;
  min_days : nat64;
  price_per_day_usd_e8s : nat64;
  enabled : bool;
  icp_ledger : principal;
  quote_ttl_nanos : nat64;
  ckbtc_ledger : principal;
  fee_ckbtc_sats : nat64;
  fee_ckusdt_micro : nat64;
};
// A locked price for one caller: deposit `amount` (+ one ledger fee) on the
// token's ledger, then call `submit_dapp` before `expires_at`.
type ExplorerQuote = record {
  token : IdeaToken;
  days : nat64;
  created_at : nat64;
  // USD value of one whole token at quote time (e8s).
  rate_usd_e8s : nat64;
  usd_total_e8s : nat64;
  amount : nat64;
  expires_at : nat64;
};
type ExplorerToken = variant { ICP; CkUSDC; CkUSDT; CkBTC; CkETH };
type Farmer = record {
  id : nat64;
  status : FarmerStatus;
  owner : principal;
  // Reported by the Farmer via report_depleted (R9: surfaced in the dashboard).
  burned_cycles : nat64;
  tier_id : nat32;
  // Display only — the cycle balance is the real 7-day timer (D2).
  expected_depleted_at : nat64;
  // None under the dev-seed mock path; Some for a real per-user canister.
  canister_id : opt principal;
  last_burn_tick_at : nat64;
  created_at : nat64;
  last_generation_at : nat64;
  persona : text;
  // ICP e8s directed to cycles (the 90% leg, net of the CMC leg fee). A
  // record of what was burned; the Farmer's own cycle balance is authoritative.
  budget_cycles : nat64;
  // Idempotency for the 90% CMC leg (PB-148 class); reset to None on CMC_REFUNDED.
  burn_block_index : opt nat64;
  cmc_notified : bool;
  treasury_block : opt nat64;
  install_done : bool;
};
type FarmerStatus = variant { Failed; Active; Disabled; Depleted };
type FarmerTier = record {
  id : nat32;
  // USD reference price (D1); XRC-quoted to ICP at payment time.
  price_usd_e8s : nat64;
  name : text;
  duration_days : nat32;
  // D9 premium — tier gets 1 Nano-Banana image/day via the proxy.
  includes_image : bool;
  drafts_per_day : nat32;
};
// Structured eligibility result — a developer's CLI/agent can render exactly
// which gate is blocking and when they're next eligible (review optimization).
type FaucetGate = variant {
  CanisterLifetimeReached : record { count : nat32 };
  CanisterNotRegistered;
  TreasuryLow;
  FaucetDisabled;
  NoPoolNeuron;
  Eligible;
  ClaimedThisWeek : record { next_at : nat64 };
  NotVotedInWindow;
};
// One recorded faucet grant, for the public transaction list. `block_index` is
// the ICP-ledger block of the treasury→CMC transfer — the on-chain transaction
// a UI can link to. Keyed in FAUCET_GRANTS by `id` (== the grant's sequence).
type FaucetGrant = record {
  at : nat64;
  id : nat64;
  dev : principal;
  block_index : nat64;
  canister_id : principal;
  amount_icp_e8s : nat64;
};
// All-time faucet stats (public transparency).
type FaucetStats = record {
  // All-time count of successful grants.
  total_claims : nat64;
  last_grant_at : nat64;
  // All-time ICP spent on grants (e8s; the treasury outflow, fees excluded).
  total_granted_icp_e8s : nat64;
};
// Everything the faucet UI / a CLI needs in one query.
type FaucetStatus = record {
  treasury_floor_e8s : nat64;
  // Caller burn-voted within the window (G3).
  voted_in_window : bool;
  // Caller has an active pool neuron (G2).
  has_pool_neuron : bool;
  // The blocking gate for `(caller, canister_id)`, or `Eligible`.
  gate : FaucetGate;
  lifetime_cap : nat32;
  // Lifetime claims used by the registered canister (of `lifetime_cap`).
  canister_claims_used : nat32;
  grant_usd_e8s : nat64;
  // Effective flag for the caller (On for all, AdminOn → admins only).
  enabled : bool;
  vote_window_ns : nat64;
  // Next time this dev OR canister may claim again (max of the two), 0 if now.
  next_eligible_at : nat64;
  // Estimated grant ICP at the current cached rate (e8s). 0 if rate unknown.
  est_grant_icp_e8s : nat64;
  claim_window_ns : nat64;
  registered : bool;
};
type FeatureFlag = record {
  key : text;
  // Effective for the CALLER (On for everyone, or AdminOn and the caller is an
  // admin). UI gating reads this.
  enabled : bool;
  // The raw three-state setting (for the admin panel to display/cycle).
  state : FlagState;
};
type FeaturedDapp = record {
  id : nat64;
  status : FeaturedStatus;
  applicant : principal;
  token : opt IdeaToken;
  days : nat64;
  approved_at : opt nat64;
  created_at : nat64;
  amount_paid : nat64;
  payment_block : opt nat64;
  usd_total_e8s : nat64;
  listing_id : nat64;
  expires_at : opt nat64;
};
// Everything the Explorer hero needs in one query.
type FeaturedInfo = record {
  max_days : nat64;
  active : vec FeaturedView;
  slots_total : nat32;
  min_days : nat64;
  price_per_day_usd_e8s : nat64;
  slots_open : nat32;
};
type FeaturedSlot = record {
  at : nat64;
  token : IdeaToken;
  token_id : nat64;
  usd_value_e8s : nat64;
  amount : nat64;
  bidder : principal;
};
type FeaturedStatus = variant { Active; Rejected; Expired; Pending };
// A featured placement joined to its listing — what the UI renders.
type FeaturedView = record { listing : DappListing; featured : FeaturedDapp };
// A feature's three states. `Off` = nobody; `On` = everybody; `AdminOn` =
// admins only (preview/playtest a feature live without exposing it).
type FlagState = variant { On; Off; AdminOn };
// App-wide totals used by the global stats strip in the UI.
// - `tvl_e8s`: sum of `total_committed_e8s` over all proposals whose status
// is `open` or `met` (i.e. escrow currently locked).
// - `total_burned_e8s`: cumulative ICP burned through this app, summed over
// every `VoteRecord` (the canonical burn ledger).
// - `votes_cast`: count of distinct NNS proposals the app has voted on,
// derived from `VOTES.len()` (includes always-adopt votes cast when the
// threshold was missed — the canonical "NNS votes cast" count).
// - `votes_threshold_met`: subset of `votes_cast` where the burn threshold was
// actually met (`icp_burned_e8s > 0`) — i.e. votes the community's burns
// actually steered. The public dashboard surfaces this, not `votes_cast`.
type GlobalStats = record {
  votes_cast : nat64;
  tvl_e8s : nat64;
  total_burned_e8s : nat64;
  // Whether the treasury can currently front the ledger fees a new commitment
  // would need at settlement/refund (cached balance ≥ TREASURY_FRONT_MIN_E8S).
  // The UI hides commit / "Add More" when false. Defaulted on decode.
  treasury_can_front_fees : bool;
  followers_count : nat64;
  pending_burn_e8s : nat64;
  votes_threshold_met : nat64;
};
// An idea is implicitly Active while stored; the sweep DELETES ideas whose
// 30-day no-upvote window has lapsed (no Expired state is kept around).
type Idea = record {
  id : nat64;
  title : text;
  upvote_count : nat64;
  total_ckbtc_e8s : nat64;
  // Detail-view opens by signed-in users (drives "most viewed" sorting).
  views : nat64;
  // Filled per-caller at query time: whether the caller has upvoted. Not stored.
  has_upvoted : bool;
  description : text;
  created_at : nat64;
  detail : text;
  total_cketh_wei : nat64;
  // Timestamp of the most recent upvote; equals `created_at` until the
  // first upvote. Drives the 30-day expiry window.
  last_upvote_at : nat64;
  total_icp_e8s : nat64;
  poster : principal;
};
// Everything the Idea Board UI needs in one query: the flag, per-token
// ledger canister ids, per-token minimum upvotes (value-aligned across
// tokens via exchange rates) and ledger fees, in smallest units.
type IdeaBoardInfo = record {
  cketh_ledger : principal;
  fee_icp_e8s : nat64;
  min_upvote_icp_e8s : nat64;
  fee_cketh_wei : nat64;
  min_upvote_ckbtc_e8s : nat64;
  enabled : bool;
  icp_ledger : principal;
  ckbtc_ledger : principal;
  // Post fee in USD e8s ($0.05), priced per token via XRC. ICP burns 100%;
  // other tokens go 100% to the treasury.
  post_fee_usd_e8s : nat64;
  expiry_nanos : nat64;
  fee_ckbtc_sats : nat64;
  min_upvote_cketh_wei : nat64;
};
type IdeaToken = variant {
  ICP;
  // Payout-record use only (token-vote refunds) — the idea board itself
  // does not accept stables.
  CkUSDC;
  CkUSDT;
  CkBTC;
  CkETH;
};
type InitPayload = record {
  default_threshold_e8s : nat64;
  owner : principal;
  // Optional explicit ledger canister id. When absent, the ledger is derived
  // from `is_local` (local test ledger vs. mainnet ICP ledger). Lets staging
  // and integration tests point at a custom/locally-installed ledger.
  ledger_canister_id : opt principal;
  ai_price_e8s : nat64;
  primary_neuron_id : nat64;
};
// Cached public stats for the community leader neuron, served to the UI.
type LeaderNeuronInfo = record {
  updated_at : nat64;
  dissolve_delay_seconds : nat64;
  stake_e8s : nat64;
  voting_power : nat64;
  neuron_id : nat64;
};
type LedgerAccount = record { owner : principal; subaccount : opt blob };
type License = record {
  at : nat64;
  id : nat64;
  buyer : principal;
  listing_id : nat64;
};
type ListedFilter = variant { No; Any; Yes };
type Listing = record {
  id : nat64;
  title : text;
  active : bool;
  price_usd_e8s : nat64;
  kind : MarketKind;
  created_at : nat64;
  seller : principal;
  sales : nat64;
  // Public shape teaser ("martingale ×2.0 @ 2.00×"). Body stays hidden.
  teaser : text;
  // For Crash: the strategy id whose body unlocks on license.
  item_id : nat64;
};
// Journal for one drawing — persisted before the prize transfer so a trap
// can't lose (or double-pay) a win. Same idempotency pattern as
// `settle_burn_split` / `settle_yield_split`.
type LotteryDraw = record {
  id : nat64;
  status : DrawStatus;
  // Gross 5% of the pot burned to backend-canister cycles on a win (the
  // transfer nets one ledger fee). 0 when there's no winner.
  cycle_burn_e8s : nat64;
  winner : opt principal;
  drawn_at : nat64;
  // Lottery-pot balance at draw time.
  pot_e8s : nat64;
  payout_block : opt nat64;
  total_tickets : nat64;
  // The random index in [0, total_tickets × 13); a ticket wins when
  // this lands below `total_tickets`.
  winning_ticket : opt nat64;
  round : nat64;
  // Idempotency for the cycle-burn leg: the ICP→CMC transfer block index.
  // None until it lands; reset to None on CMC_REFUNDED to re-transfer.
  cycle_burn_block : opt nat64;
  // Gross 65% prize (the winner nets this minus one ledger fee).
  prize_e8s : nat64;
};
// Everything the Lottery page needs in one call (update — it reads the pot
// balance from the ledger).
type LotteryInfo = record {
  draws_held : nat64;
  next_draw_at : nat64;
  total_paid_e8s : nat64;
  claimed_today : bool;
  // Drawings only run when the pot holds at least this much (rolls over
  // otherwise). The countdown still ticks below the line.
  min_pot_e8s : nat64;
  // Base daily grant for a 6-month staker (admin-tunable).
  tickets_per_day : nat64;
  odds_denominator : nat64;
  // Minimum distinct holders a draw needs (admin-tunable; 0 = no gate).
  min_unique_holders : nat64;
  enabled : bool;
  pot_e8s : nat64;
  // The caller's actual daily grant across their staked tiers (0 = not
  // staked / not eligible).
  my_daily_tickets : nat64;
  last_win_at : opt nat64;
  last_winner : opt principal;
  // Whether the caller holds any stake (the eligibility gate).
  eligible : bool;
  total_tickets : nat64;
  // Distinct ticket-holders in the current round (the players progress bar).
  unique_holders : nat64;
  // True when the caller is an admin — admins never hold tickets.
  admin_excluded : bool;
  my_tickets : nat64;
  round : nat64;
};
type MarketKind = variant { Crash };
type MarketplaceFilter = record {
  theme : opt nat8;
  difficulty : DifficultyFilter;
  mine_only : bool;
  listed : ListedFilter;
};
type MarketplacePage = record {
  total : nat64;
  courses : vec CourseCard;
  seed : nat64;
  featured_token_id : opt nat64;
};
type MaturityDisbursement = record {
  amount_e8s : nat64;
  // When the minted ICP should arrive in the yield inbox (~+7 days).
  expected_at : nat64;
  initiated_at : nat64;
};
type MintError = variant {
  InvalidCourse : text;
  AlreadyMinting;
  InsufficientDeposit : record { found : nat64; needed : nat64 };
  NotAuthenticated;
  FeeSettlementFailed : text;
  MintCallFailed : text;
};
// One surfaced moderation candidate (admin-only view).
type ModerationCandidate = record {
  token_id : nat64;
  owner : opt principal;
  hidden : bool;
  rating_count : nat32;
  avg_x10 : nat32;
};
type MyCasinoView = record {
  chips : nat64;
  available_chips : nat64;
  reserved_chips : nat64;
  staking_weight_e8s : nat64;
  effective_vp_e8s : nat64;
  delta_e8s : int64;
};
type NeuronFollowStatus = record {
  topics_following_primary : vec int32;
  // Uncollected yield: maturity that hasn't been harvested yet. Tier
  // neurons harvest automatically once this crosses the configured
  // maturity threshold (default 1.05 ICP); the EA neuron settles monthly.
  maturity_e8s : nat64;
  label : text;
  error : opt text;
  // Live neuron stake (cached_neuron_stake_e8s).
  stake_e8s : nat64;
  // True when all three followed topics (catch-all, Governance,
  // SNS & Neurons' Fund) point at the primary neuron.
  follows_primary : bool;
  neuron_id : nat64;
};
type NotifyError = variant {
  Refunded : record { block_index : opt nat64; reason : text };
  InvalidTransaction : text;
  Other : record { error_message : text; error_code : nat64 };
  Processing;
  TransactionTooOld : nat64;
};
type NotifyTopUpArgs = record { block_index : nat64; canister_id : principal };
type NotifyTopUpResult = variant { Ok : nat; Err : NotifyError };
// One payout the site made to a user, in the token's smallest unit. Drives
// the "Payout history" page.
type Payout = record {
  id : nat64;
  token : IdeaToken;
  payout_type : PayoutType;
  user : principal;
  created_at : nat64;
  amount : nat64;
  // Source record id (draw id, unstake id, upvote id, proposal id).
  ref_id : nat64;
};
type PayoutType = variant {
  // 25% of a settled burn, split among the top pool neurons' owners.
  PoolReward;
  IdeaUpvoteShare;
  // A claimed monthly Early Adopter yield share.
  EarlyAdopterYield;
  CommitmentRefund;
  UnstakeDisbursement;
  LotteryWin;
};
type PendingUnstake = record {
  id : nat64;
  status : UnstakeStatus;
  // Tier the dissolving neuron was merged back into (status == Merged).
  merged_into : opt StakeTier;
  disburse_block : opt nat64;
  split_neuron_id : nat64;
  tier : StakeTier;
  user : principal;
  created_at : nat64;
  // Treasury fee reimbursement (0.0003 ICP) — makes the cycle zero-loss.
  // Set when the refund transfer lands; the sweep retries until it does.
  fee_refund_block : opt nat64;
  amount_e8s : nat64;
  // Nanosecond timestamp when the split neuron finishes dissolving (the
  // tier's full term).
  dissolve_eta : nat64;
  // What the split child actually holds. Some(amount) since the treasury
  // started fronting the split fee (the child holds exactly the requested
  // amount); None for legacy unstakes where the NNS took the split fee
  // out of the child (child = amount − 0.0001).
  child_e8s : opt nat64;
  settled_at : opt nat64;
};
type PoolInfo = record {
  total_pool_voting_power : nat64;
  active_neurons : vec ActivePoolNeuron;
  active_count : nat64;
};
type PoolNeuron = record {
  status : PoolStatus;
  activated_at : opt nat64;
  frontend_cmc_block : opt nat64;
  created_at : nat64;
  treasury_block : opt nat64;
  backend_cmc_block : opt nat64;
  registered_by : principal;
  voting_power : nat64;
  neuron_id : nat64;
};
type PoolStatus = variant { Inactive; Active; Draft };
type ProgressionRule = record { action : BetAction; factor_x100 : nat64 };
// goes 100% to the protocol treasury, which pays for the project's
// execution. Each project has ONE USD-denominated goal and accepts any
// supported crypto; contributions (tracked per-token) are valued at the
// cached USD rate and summed into `raised_usd_e8s` for progress.
type Project = record {
  id : nat64;
  raised_ckbtc_e8s : nat64;
  title : text;
  // The single funding goal, in USD e8s ($1 = 100_000_000).
  goal_usd_e8s : nat64;
  goal_ckbtc_e8s : nat64;
  // Filled at query time: per-token raised pots valued in USD e8s. Not stored.
  raised_usd_e8s : nat64;
  raised_cketh_wei : nat64;
  description : text;
  created_at : nat64;
  funding_count : nat64;
  detail : text;
  accept_ckbtc : bool;
  accept_cketh : bool;
  goal_cketh_wei : nat64;
  accept_icp : bool;
  goal_icp_e8s : nat64;
  raised_icp_e8s : nat64;
};
type Proposal = record {
  id : nat64;
  status : text;
  nns_proposal_id : opt nat64;
  reject_pot_e8s : nat64;
  title : text;
  pool_distributed : bool;
  lossless_reject_e8s : nat64;
  deadline : nat64;
  // Lossless-staking vote weight on each side. Adds to the balance-of-power
  // that decides the NNS vote direction; never counts toward the burn
  // threshold (`total_committed_e8s`). Defaulted on decode for upgrades.
  lossless_adopt_e8s : nat64;
  // NNS proposal summary/description (distinct from the title). Defaulted on
  // decode so older stored proposals upgrade cleanly.
  summary : text;
  adopt_pot_e8s : nat64;
  threshold_e8s : nat64;
  total_burned_e8s : opt nat64;
  vote_executed_at : opt nat64;
  category : text;
  // Stance of the first commit on this proposal — the tie-breaker if the
  // adopt/reject pots end exactly equal. Defaulted on decode for upgrades.
  first_stance : opt Stance;
  total_committed_e8s : nat64;
  // USD threshold (e8s of USD) — when present the proposal meets its
  // threshold by the USD VALUE of its pots, not raw ICP.
  threshold_usd_e8s : opt nat64;
};
type Rating = record {
  updated_at : nat64;
  token_id : nat64;
  "text" : opt text;
  created_at : nat64;
  stars : nat8;
  rater : principal;
};
type RecordHoleOk = record {
  owner : opt principal;
  last_hole : nat8;
  owner_credited : bool;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : nat64; Err : text };
type Result_10 = variant { Ok : nat64; Err : MintError };
type Result_11 = variant { Ok : RecordHoleOk; Err : text };
type Result_12 = variant { Ok : StartSessionOk; Err : text };
type Result_13 = variant { Ok : bool; Err : text };
type Result_14 = variant { Ok : CrashVerifyView; Err : text };
type Result_15 = variant { Ok : WhoamiReply; Err : text };
type Result_2 = variant { Ok : text; Err : text };
type Result_3 = variant { Ok : CompleteRoundOk; Err : text };
type Result_4 = variant { Ok : Farmer; Err : text };
type Result_5 = variant { Ok : nat32; Err : text };
type Result_6 = variant { Ok : ExplorerQuote; Err : text };
type Result_7 = variant { Ok : vec XFarmDraft; Err : text };
type Result_8 = variant { Ok : record { Farmer; nat64; nat64 }; Err : text };
type Result_9 = variant { Ok : XFarmQuote; Err : text };
type SeenUser = record { last_seen_ns : nat64; first_seen_ns : nat64 };
// Fixed staking terms. The 6-month minimum matches the NNS minimum dissolve
// delay for voting eligibility, so no Mission 70 gate applies. Voting weight
// and the daily lottery-ticket grant both scale with the same multiplier,
// proportional to the term length (6mo = 1×, 1y = 2×, 2y = 4×).
type StakeTier = variant { OneYear; SixMonths; TwoYears };
type StakingBootstrap = variant {
  // Neuron claimed; dissolve delay not yet set.
  Claimed;
  // Fully configured: delay set + following the leader on all topics.
  Ready;
  // Dissolve delay set; followees not yet configured.
  DelaySet;
  // No neuron yet (no stake has ever been claimed).
  NotStarted;
};
type StakingPoolInfo = record {
  min_stake_e8s : nat64;
  total_staked_e8s : nat64;
  // Lifetime yield harvested across all tiers (split 70/30 lottery pot /
  // treasury at distribution).
  total_yield_e8s : nat64;
  pools : vec TierPoolInfo;
  min_unstake_e8s : nat64;
};
type Stance = variant { Reject; Adopt };
type StartSessionOk = record { server_time : nat64; session_id : nat64 };
type StrategyStop = record {
  // -loss in VP-x1000 that ends the session (0 = none).
  stop_loss_vp_x1000 : nat64;
  // max rounds before stopping (0 = none).
  max_rounds : nat64;
  // +profit in VP-x1000 that ends the session (0 = none).
  take_profit_vp_x1000 : nat64;
};
type Thread = record {
  id : nat64;
  title : text;
  // Filled per-caller at query time (the caller's vote on this thread); not stored.
  my_vote : opt VoteDir;
  upvote_count : nat64;
  comment_count : nat64;
  // Lottery tickets minted to the author so far (per-thread reward cap).
  tickets_awarded : nat64;
  body : text;
  created_at : nat64;
  last_activity_at : nat64;
  author : principal;
  proposal_id : nat64;
  downvote_count : nat64;
};
// Public state of one tier's pooled neuron.
type TierPoolInfo = record {
  pending_refresh_e8s : nat64;
  dissolve_delay_secs : nat64;
  // Daily lottery tickets a staker in this tier collects.
  daily_tickets : nat64;
  total_staked_e8s : nat64;
  tier : StakeTier;
  staker_count : nat64;
  bootstrap : StakingBootstrap;
  total_yield_e8s : nat64;
  weight_multiplier : nat64;
  pending_maturity : vec MaturityDisbursement;
  neuron_id : opt nat64;
};
type TokenUsdRate = record {
  token : IdeaToken;
  // USD value of one whole token, e8s of USD ($1 = 100_000_000).
  rate_usd_e8s : nat64;
};
// One row of the Profile page's transaction history: everything the user
// paid the site (escrow deposits, fees, stakes) and everything the site
// paid them (the payout records), unified and newest-first.
type TransactionRecord = record {
  direction : TxDirection;
  token : IdeaToken;
  // Machine-readable kind: payout-type names for In ("LotteryWin", …);
  // audit event names for Out ("deposit", "idea_post", "stake", …).
  kind : text;
  timestamp : nat64;
  amount : nat64;
  ref_id : nat64;
};
type TxDirection = variant { In; Out };
type UnstakeStatus = variant {
  // ICP disbursed to the user's wallet. Terminal.
  Disbursed;
  // Merged back into a tier pool neuron at the user's request. Terminal.
  Merged;
  // Dissolving; disbursable once `dissolve_eta` passes.
  Dissolving;
  // Neuron split off; StartDissolving not yet confirmed (sweep retries).
  SplitDone;
};
type UserBalanceRow = record {
  icp : nat;
  "principal" : principal;
  ckbtc : nat;
  cketh : nat;
  ckusdc : nat;
  ckusdt : nat;
};
type UserStakeInfo = record {
  tiers : vec UserTierStake;
  // Sum of the caller's stakes across tiers.
  total_staked_e8s : nat64;
  // Sum of amount × multiplier across tiers — the caller's voting power.
  total_weight_e8s : nat64;
};
// The caller's stake in one tier (part of UserStakeInfo).
type UserTierStake = record {
  tier : StakeTier;
  // (amount ÷ 10) × tenure multiplier — the voting power this position
  // contributes right now.
  weight_e8s : nat64;
  amount_e8s : nat64;
  // When the next doubling lands (ns); 0 once capped at 16×.
  next_double_at : nat64;
  staked_at : nat64;
  // Current tenure multiplier (1/2/4/8/16 — doubles every 6 months).
  tenure_multiplier : nat64;
  last_action_at : nat64;
};
type Vote = variant { No; Yes; Abstain };
type VoteDir = variant { Up; Down };
type VoteRecord = record {
  vote : Vote;
  proposal_id : nat64;
  nns_outcome : opt text;
  decided_at : nat64;
  icp_burned_e8s : nat64;
};
// Login ping: any signed-in caller records its first/last-seen timestamp and
// gets back `(principal, first_seen_ns, last_seen_ns)`. The frontend fires this
// on login so a principal is captured even if it never makes another
// authenticated call (e.g. lottery disabled, pure browsing). Not admin-gated.
type WhoamiReply = record {
  "principal" : principal;
  last_seen_ns : nat64;
  first_seen_ns : nat64;
};
type XFarmDraft = record {
  id : nat64;
  cited_url : opt text;
  image_url : opt text;
  "text" : text;
  created_at : nat64;
};
type XFarmInfo = record {
  wasm_uploaded : bool;
  tiers : vec FarmerTier;
  active_count : nat64;
  enabled : bool;
  proxy_set : bool;
  max_active_farmers : nat64;
};
type XFarmQuote = record {
  days : nat32;
  tier_id : nat32;
  fee_e8s : nat64;
  created_at : nat64;
  rate_usd_e8s : nat64;
  price_e8s : nat64;
  usd_e8s : nat64;
  expires_at : nat64;
};
// Saga journal for one yield distribution: the shared yield inbox (fed by
// all three tier neurons) is drained 50% to the lottery prize pot / 50% to
// the treasury. Persisted per-leg block indices make a retry skip completed
// transfers (same idempotency as `settle_burn_split`).
type YieldDistribution = record {
  id : nat64;
  status : YieldStatus;
  created_at : nat64;
  lottery_block : opt nat64;
  // Inbox balance this distribution drains (includes the 2 transfer fees).
  amount_e8s : nat64;
  lottery_amount_e8s : nat64;
  treasury_block : opt nat64;
  completed_at : opt nat64;
  treasury_amount_e8s : nat64;
};
type YieldStatus = variant { Done; InProgress };
service : (InitPayload) -> {
  add_admin : (principal) -> (Result);
  // Add a comment ($0.25) to a thread. `parent_id` = None for top-level, or a
  // top-level comment id for a one-level reply. Fee routes by token (ICP burns,
  // non-ICP → treasury), same as threads.
  add_comment : (nat64, opt nat64, text, ExplorerToken) -> (Result_1);
  add_to_commitment : (nat64, nat64) -> (Result);
  // Admin: add a permanent curated listing (no payment, no badge, no expiry).
  admin_add_dapp : (text, text, text, vec text) -> (Result_1);
  // Admin: add a fundable project with a single USD goal. Every project accepts
  // any supported crypto; contributions are valued in USD toward the goal.
  admin_add_project : (text, text, text, nat64) -> (Result_1);
  // Admin: approve a pending community listing. Its paid `days` window starts
  // now.
  admin_approve_dapp : (nat64) -> (Result);
  // Admin: approve a pending featured application — goes live for `days`.
  // Synchronous (no await) so the max-3 count-then-set is atomic / race-safe.
  admin_approve_featured : (nat64) -> (Result);
  // Admin-forced burn of ANY course token regardless of owner (PB-3xx). Same
  // destructive marketplace cleanup as `burn_course_nft`, but skips the
  // caller-is-live-owner check (the burn is on admin authority). The course_nft
  // canister accepts a burn from the backend (the allowlisted minter), so this
  // works for any token. Idempotent: a "token already gone" reject from the
  // wrapper is treated as success.
  admin_burn_course : (nat64) -> (Result);
  // Admin diagnostic: live follow status of every platform-owned neuron
  // (the three staking tiers + the early-adopter neuron), read from NNS
  // governance. Answers "are our neurons actually following the primary?".
  admin_check_neuron_following : () -> (vec NeuronFollowStatus);
  admin_clear_featured_slot : () -> (Result);
  // Admin: force ONE stuck commitment (FailedBurn / FailedRefund / StuckFunds)
  // to a terminal `Burned` state so the 5-minute settlement retry sweep stops
  // re-attempting it forever. Use only when the escrow is verified empty and the
  // settlement saga can never succeed — e.g. a legacy token commitment whose
  // escrow was never funded (approve fails InsufficientFunds balance 0). Does
  // NOT move funds (verify the escrow is empty beforehand via the ledger) and
  // does NOT alter the proposal's `total_burned` (the commitment produced 0 ICP;
  // it was never counted as burned, and we don't count it now). Rejects if the
  // commitment is not in a stuck state, so it can't be misused on active ones.
  admin_close_stuck_commitment : (nat64, principal) -> (Result);
  admin_delete_chat : (nat64) -> (Result);
  admin_disable_farmer : (nat64) -> (Result);
  // Admin: allocate treasury ICP into the early-adopter neuron (compounds the
  // program's yield; distributed by the normal monthly bands).
  admin_fund_early_adopter_neuron : (nat64, bool) -> (Result);
  // Admin: allocate treasury ICP into a tier pool neuron (boosts its yield —
  // and therefore the lottery pot — without belonging to any staker).
  admin_fund_tier_neuron : (StakeTier, nat64, bool) -> (Result);
  // Admin: the FRONTEND canister's live cycle balance, via the management
  // canister. Requires this backend to be a controller of the frontend
  // canister (ops: `icp canister update-settings frontend --add-controller
  // <backend-id>`); otherwise returns the management canister's rejection.
  admin_get_frontend_cycles : () -> (Result_1);
  admin_hide_course : (nat64) -> (Result);
  // Owner one-time bootstrap: draw the genesis seed, build the hash chain,
  // publish the terminal commitment, seed builtin strategies, and start the
  // round loop. Idempotent (re-running with an initialized chain is a no-op
  // except for re-arming the loop). The `crash` flag must already be ON.
  admin_init_crash : () -> (Result_2);
  admin_list_moderation_candidates : (nat32) -> (vec ModerationCandidate) query;
  // Admin: every unstake record across all users — the split neurons the
  // canister manages on users' behalf (dissolving, restaked, disbursed).
  admin_list_pending_unstakes : () -> (vec PendingUnstake) query;
  // Admin: every principal that has ever logged in, with first/last-seen
  // timestamps. Zero ledger outcalls — the primary "all logged-in principals"
  // list. Sorted by `last_seen_ns` descending (most recent login first).
  admin_list_seen_users : () -> (vec record { principal; SeenUser }) query;
  // Admin: every known participant principal (dedup union across all features).
  // Cheap (no outcalls) — the frontend pages this list into `admin_user_balances`.
  admin_list_user_principals : () -> (vec principal) query;
  admin_mute_chat : (principal, nat64) -> (Result);
  // Pause/unpause the round loop. The current round still settles; no new
  // betting window opens while paused.
  admin_pause_crash : (bool) -> (Result);
  // Admin: refund a stranded token deposit from ONE specific proposal's escrow —
  // fast (a single ledger read), for when the full scan is too slow. Token-aware
  // guard: refuses only if a commitment actually owns this token's escrow.
  admin_refund_commitment_escrow : (principal, nat64, ExplorerToken) -> (
      Result_1,
    );
  admin_refund_stranded_commitments : (principal, ExplorerToken) -> (Result_1);
  // Admin recovery: refund a specific user's stranded x-farm escrow deposit.
  admin_refund_xfarm_escrow : (principal) -> (Result_1);
  // Admin: upgrade every existing Farmer canister to the currently-uploaded wasm
  // (preserves each Farmer's stable state via post_upgrade). Rolls out a Farmer-wasm
  // fix to already-created Farmers. Returns the count upgraded; bounded by live Farmers.
  admin_reinstall_all_farmers : () -> (Result_1);
  // Admin: reject a pending community listing. The payment is refunded from
  // the treasury (minus one ledger fee), then the listing is deleted.
  // The listing is REMOVED before the refund transfer (and restored if it
  // fails) so a concurrent second reject — or an interleaved approve — can't
  // refund the same payment twice across the await (review 2026-06-11).
  admin_reject_dapp : (nat64) -> (Result);
  // Admin: reject a pending featured application — refund from the treasury
  // (claim-before-await so a concurrent reject can't double-refund).
  admin_reject_featured : (nat64) -> (Result);
  // Admin: remove any listing outright (no refund — use admin_reject_dapp for
  // pending submissions that should get their payment back).
  admin_remove_dapp : (nat64) -> (Result);
  // Admin: take a live featured placement down early (no refund — the premium was
  // already earned). Frees its slot immediately.
  admin_remove_featured : (nat64) -> (Result);
  // Admin: remove an idea from the board at any time. Settled upvotes stay in the
  // treasury/poster; any in-flight upvote saga refunds via the orphan path.
  admin_remove_idea : (nat64) -> (Result);
  // Admin: remove a project from the board. Settled funding stays in the
  // treasury; any in-flight funding saga refunds via the orphan path.
  admin_remove_project : (nat64) -> (Result);
  admin_remove_rating : (nat64, principal) -> (Result);
  // Admin: delete a thread + its comments + their votes (the only moderation
  // lever; D4 = no queue/filter).
  admin_remove_thread : (nat64) -> (Result);
  // Admin: drop one hole's override, reverting it to the built-in layout.
  admin_reset_arcade_hole : (nat8) -> (Result);
  // Admin: trigger one supply sample now and return the value (or the exact error).
  // Diagnostic + manual backfill for the dashboard chart.
  admin_sample_supply_now : () -> (Result_1);
  // Genesis default course (PB-309 A7/B3). Minted exactly ONCE to the admin
  // principal as a NORMAL ICRC-7 course NFT, auto-listed and playable, so the
  // marketplace is never empty. Idempotent: guarded by `SYSTEM_COURSE_MINTED`, so
  // re-deploys/upgrades — and the admin SELLING it via the normal sale path —
  // never mint a second copy. No transfer restriction: it's "default" only in
  // that it always exists from genesis. Admin-gated; callable from deploy-local
  // and prod to recover a no-op seed without another upgrade (B6).
  admin_seed_system_course : () -> (Result_1);
  // Admin: move cycles from THIS backend into the frontend canister — a one-way
  // `deposit_cycles` top-up; the cycles are deducted from the backend's own
  // balance. Used to rebalance an over-provisioned backend.
  admin_send_cycles_to_frontend : (nat64) -> (Result);
  // Admin: replace one hole's voxel layout (0-based index). Validated so a
  // typo can't ship an unplayable grid.
  admin_set_arcade_hole : (nat8, ArcadeHoleDef) -> (Result);
  admin_set_course_nft_canister : (principal) -> (Result);
  admin_set_default_threshold : (nat64) -> (Result);
  // Admin: change the default voting threshold at any time. Updates the config
  // default (applied to all future / live-ingested proposals) AND re-applies the
  // new threshold to every currently open/met proposal, recomputing their
  // open↔met status. Terminal proposals (voted/settled/abstained/failed) are left
  // untouched so in-flight settlement is never disturbed.
  // Admin: dollar-denominated voting threshold (e8s of USD; $1 = 100_000_000).
  // Applies to every open/met proposal immediately and to all future ones.
  // Pots are valued at the cached ICP/USD rate (XRC on mainnet).
  admin_set_default_threshold_usd : (nat64) -> (Result);
  // Admin: point ckUSDC (or the other tokens) at locally deployed test
  // ledgers. Local-only — mainnet ledgers are hard-pinned.
  admin_set_explorer_ledger : (ExplorerToken, principal) -> (Result);
  admin_set_exposure_cap : (nat64) -> (Result);
  admin_set_faucet_claim_window_days : (nat64) -> (Result);
  admin_set_faucet_grant_usd : (nat64) -> (Result);
  admin_set_faucet_lifetime_cap : (nat32) -> (Result);
  admin_set_faucet_treasury_floor : (nat64) -> (Result);
  admin_set_faucet_vote_window_days : (nat64) -> (Result);
  // Admin: enable/disable a feature completely. Unknown keys are allowed (a
  // kill-switch can be staged before the feature ships) but validated and
  // capped so the map can't be spammed.
  admin_set_feature_flag : (text, bool) -> (Result);
  // Admin: set a feature's three-state flag — Off (nobody), On (everybody), or
  // AdminOn (admins only, for a live preview/playtest).
  admin_set_feature_flag_state : (text, FlagState) -> (Result);
  // Admin: set the frontend canister id that receives the 25% cycles share (PB-125).
  admin_set_frontend_canister : (principal) -> (Result);
  // Admin: tune how many tickets a daily login credits.
  admin_set_lottery_config : (opt nat64) -> (Result);
  // Admin: set the minimum number of unique ticket-holders a round needs before a
  // draw runs (below it the drawing rolls over). 0 disables the gate.
  admin_set_lottery_min_holders : (nat64) -> (Result);
  // Admin: retune a token's minimum upvote (smallest units) as exchange
  // rates move, keeping minimums roughly value-aligned across tokens.
  admin_set_min_upvote : (IdeaToken, nat64) -> (Result);
  // Admin: set the initiation fee for joining the neuron pool (PB-130).
  admin_set_pool_fee : (nat64) -> (Result);
  admin_set_proposal_deadline : (nat64, nat64) -> (Result);
  // Admin: tune the staking parameters. Pass null to leave a value unchanged.
  // (Dissolve delays are fixed per tier — 6 months / 1 year / 2 years — and
  // not configurable.)
  admin_set_staking_config : (opt nat64, opt nat64, opt nat64) -> (Result);
  // Admin: wire a vote token to its ICPSwap pool (mainnet swap path).
  admin_set_swap_pool : (IdeaToken, principal, bool) -> (Result);
  // Admin: point ckBTC/ckETH at locally deployed test ledgers. Local-only —
  // mainnet token ledgers are hard-pinned to the canonical canisters.
  admin_set_token_ledger : (IdeaToken, principal) -> (Result);
  // Admin: seed/override a token's USD rate (e8s per whole token). The local
  // network has no XRC so this is the only knob there; on mainnet it acts as
  // an emergency seed that the next successful XRC refresh overwrites.
  admin_set_usd_rate : (IdeaToken, nat64) -> (Result);
  admin_set_xfarm_config : (nat64) -> (Result);
  admin_set_xfarm_proxy : (text, text) -> (Result);
  admin_set_xfarm_tiers : (vec FarmerTier) -> (Result);
  // Upload the Farmer wasm the factory installs (heap-cached; re-upload after an
  // upgrade). Records the sha256 audit hash. Rotatable by re-calling.
  admin_set_xfarm_wasm : (blob) -> (Result);
  admin_trigger_sweep : () -> (Result);
  admin_unhide_course : (nat64) -> (Result);
  // Admin: update a project's details and its single USD funding goal.
  admin_update_project : (nat64, text, text, text, nat64) -> (Result);
  // Admin: wallet balances (own default account) for a chunk of principals across
  // all five supported tokens. Call in batches (e.g. ~8/call → ~40 outcalls) and
  // accumulate client-side. Uses `explorer_token_ledger` (mainnet ledgers are
  // hardcoded there) — NOT the raw config Options, which are null on mainnet and
  // made every ck-token balance read 0.
  admin_user_balances : (vec principal) -> (vec UserBalanceRow);
  // Admin: recover token deposits stranded in a user's commitment escrows — e.g. a
  // token deposited for a vote that the commit then rejected without refunding.
  // Scans every known proposal and refunds any non-empty escrow that NO live
  // commitment owns (`commitment_in_flight` guard), so a real in-flight commitment
  // is never clawed back. Returns the total refunded (token smallest units).
  // Admin: proposal ids where `user` holds a commitment (any status). Cheap (no
  // ledger calls) — used to target stranded-escrow refunds without a full scan.
  admin_user_commitment_proposals : (principal) -> (vec nat64) query;
  // Catastrophic-wedge escape hatch (writer #4): refund every wager in the
  // current round (delta 0 for all, house delta 0) and archive it void.
  admin_void_crash_round : () -> (Result);
  // Admin: withdraw ICP from the treasury subaccount to a destination
  // principal. Guarded by the 15 ICP floor unless `override_floor`.
  admin_withdraw_treasury : (principal, nat64, bool) -> (Result);
  // Admin: withdraw ANY supported token from the treasury account (the same
  // subaccount exists on every configured ledger — upvote shares, explorer
  // payments etc. accumulate there). The 15 ICP floor applies to ICP only.
  admin_withdraw_treasury_token : (IdeaToken, principal, nat64, bool) -> (
      Result,
    );
  // Apply to feature an Approved listing you own. Requires a fresh featured quote
  // and the quoted amount (+ fee) deposited on get_featured_deposit_address. The
  // premium moves to the treasury; the application is Pending until an admin
  // approves it (rejection refunds). One active/pending placement per listing.
  apply_featured : (nat64, IdeaToken, nat64) -> (Result_1);
  bid_featured_slot : (nat64, IdeaToken, nat64) -> (Result);
  // Owner-initiated burn of a course NFT, with backend marketplace cleanup
  // (PB-3xx). Destructive + a security boundary, so:
  // 1. Reject anonymous.
  // 2. Verify the caller is the LIVE owner via `course_nft.icrc7_owner_of`
  // (never the cached listing row — the cache can be stale / spoofable).
  // A non-owner gets `NOT_OWNER`; a missing token gets `TOKEN_NOT_FOUND`.
  // 3. Burn on the verified owner's behalf via `course_nft.burn(nat)` (the
  // backend is the allowlisted minter, which the canister also accepts for
  // burn). A "token already gone" reject is treated as success by the
  // wrapper so the path is idempotent.
  // 4. Clean up backend state: drop the COURSE_LISTINGS row and clear
  // FEATURED_SLOT if it pointed at this token. Favorites are per-user lists
  // that already skip missing tokens (list_my_favorite_courses), so they are
  // left to lazy cleanup rather than scanned here.
  burn_course_nft : (nat64) -> (Result);
  // Buy a listed-for-sale course (PB-307). Pure-escrow saga (A6/C3):
  // validate → pull buyer's price into escrow → transfer NFT FIRST →
  // pay the 75/10/5/5/5 legs out of escrow. On transfer failure, refund the
  // escrow to the buyer (the treasury never fronts the price).
  buy_course_nft : (nat64) -> (Result);
  // Buy a license: 80% to the seller, 20% to the treasury (one payment path for
  // both kinds). The buyer must have pre-approved the canister via icrc2_approve.
  buy_license : (nat64, IdeaToken) -> (Result_1);
  cancel_pool_draft : (nat64) -> (Result);
  // Credit today's tickets (once per UTC day). Requires an active stake —
  // the grant scales with the staked tiers (see `user_daily_tickets`). The
  // frontend calls this on login / page load; returns the caller's
  // current-round ticket count.
  claim_daily_tickets : () -> (Result_1);
  // Boosters never pay ICP to users — yield funds the lottery + treasury (70/30 lottery/treasury).
  // Retained as a hard guard against any legacy `claimable_e8s`: it always
  // refuses. Legacy shares are drained to the treasury at the next settlement.
  claim_early_adopter_yield : () -> (Result_1);
  // Claim a $2-USD cycles grant for a previously-registered canister. Enforces
  // G1–G6, then tops up the target via the existing CMC pipeline. Idempotent
  // saga: the in-flight block index is journaled on the registration so a retry
  // re-notifies the same block (never double-mints); a CMC refund drops it so the
  // retry re-transfers. Records the claim only AFTER the cycles are minted.
  claim_faucet_cycles : (principal) -> (Result);
  commit : (nat64, Stance, nat64) -> (Result);
  // Commit a vote in ANY supported token. The token is ESCROWED — it only
  // converts to ICP if the proposal passes its threshold and the vote is cast
  // (settlement swap, then the standard burn split). If the threshold misses,
  // the refund pays back the SAME token. Pots and threshold maths use the
  // oracle ICP-equivalent at commit time. Fund the per-proposal escrow
  // (get_deposit_address) on the TOKEN's ledger first. $1 minimum.
  commit_token : (nat64, Stance, IdeaToken, nat64) -> (Result);
  complete_round : (nat64) -> (Result_3);
  // Self-attested follow (Option C). We do NOT verify neuron ownership on-chain:
  // because Internet Identity gives this app a per-dapp principal that can't equal
  // the user's NNS principal, and the canister isn't a hotkey on arbitrary neurons,
  // trustless ownership proof isn't possible without heavy hotkey onboarding. The
  // real skin-in-the-game is the ICP burn itself, so following the leader neuron is
  // encouraged but self-attested. The user confirms in the UI; we record it here.
  confirm_follow : () -> (Result);
  // Place a crash bet. `wager_chips` 10..10_000_000; `target_x100` is the auto
  // cash-out (101..5_000) or **0 for no auto cash-out** (manual only — cash out
  // with `crash_cashout`). Humans and agent principals are identical here — no
  // registry, no claim step (C9). The auto target is the latency-fair primary
  // mechanism (C7); the payout cap is always enforced.
  crash_bet : (nat64, nat64) -> (Result);
  // Manual CASH OUT (the bonus action, C7). Executes at the multiplier of the
  // block that processes it — never above your own auto target, and only while
  // the round is still running (i.e. before the crash). First writer wins;
  // duplicate/late calls return ALREADY_SETTLED / TOO_LATE without mutation.
  crash_cashout : () -> (Result_1);
  // Public nudge: advance the loop if a phase is overdue. On a real subnet the
  // autonomous timers do this; locally (and as a self-heal) the frontend calls
  // this each poll so the round loop progresses whenever someone is watching.
  crash_poke : () -> ();
  // Author a crash strategy. Costs $5 (charged in `token` via the shared quote
  // flow — same machinery as the explorer/idea-board fees: the caller must have
  // pre-approved the canister via icrc2_approve). ≤ 20 per author, ≤ 4 KB.
  create_crash_strategy : (CrashStrategyInput, IdeaToken) -> (Result_1);
  // Create a Farmer: escrow → 10% treasury → create+install the Farmer canister →
  // 90% burn-to-cycles funding it (CMC topup, journaled). Reuses settle_burn_split's
  // CMC leg + submit_dapp's escrow ordering. Per R5 the order is create→install→top-up;
  // a partial failure leaves a persisted Farmer the sweep can resume or clean up.
  create_farmer : (nat32, text, nat32) -> (Result_4);
  create_pool_draft : (nat64) -> (Result);
  // Change the golfer's look (palette indices) for $1, paid in any supported
  // token (ICP / ckBTC / ckETH / ckUSDC / ckUSDT) at the quoted rate.
  customize_character : (nat8, nat8, nat8, IdeaToken) -> (Result);
  // Change the Field Goal kicker's look for $1, paid in any supported token
  // at the quoted rate — the same quote + deposit flow as the golfer
  // (get_arcade_customize_quote / get_arcade_deposit_address).
  customize_kicker : (nat8, nat8, nat8, IdeaToken) -> (Result);
  // PB-307 A2: take a course off sale. Flips `for_sale=false`, clears the price.
  // The listing row (and `listed` visibility / ticket accrual) is preserved.
  delist_course : (nat64) -> (Result);
  // Local-dev: credit simulated maturity to one tier's mock pool neuron so
  // the yield harvest + distribution can be exercised end-to-end.
  dev_add_mock_maturity : (nat64, StakeTier) -> (Result);
  // Local-dev: promote the caller to admin with one click (drives the admin
  // console / How-it-works flows in local testing). Hard-blocked off the local
  // network by `require_local_dev` — this can never run in production.
  dev_become_admin : () -> (Result);
  // Local-dev: wipe all course listings, ratings, sales, the featured slot, and
  // favourites referencing removed tokens, so the marketplace shows its empty
  // state. Returns how many listings were removed.
  dev_clear_courses : () -> (Result_1);
  dev_clear_farmers : () -> (Result);
  // Local-dev: vacate the featured slot.
  dev_clear_featured : () -> (Result);
  dev_clear_featured_dapps : () -> (Result);
  // Local-dev: wipe all threads, comments, votes, and reward markers. Local only.
  dev_clear_threads : () -> (Result);
  // Local-dev: make a pending unstake disbursable right now (clears both the
  // record's ETA and the mock neuron's dissolve clock).
  dev_fast_forward_dissolve : (nat64) -> (Result);
  // Local-dev faucet — sends 100 ICP from the canister's own account to the caller.
  // Rejected on mainnet (ledger canister ID check). Never callable by anonymous.
  dev_faucet : () -> (Result);
  // Local-dev faucet for idea-board tokens: 100 ICP, 0.1 ckBTC, or 1 ckETH
  // from the canister's own account on the token's local ledger. Rejected on
  // mainnet (ledger canister ID check). Never callable by anonymous.
  dev_faucet_token : (IdeaToken) -> (Result);
  // Local-dev: top up the lottery pot by transferring ICP from the canister's
  // default account into the pot subaccount, so the pot threshold can be exercised
  // without waiting on staking yield. Local only.
  dev_fund_lottery_pot : (nat64) -> (Result);
  // Local-dev: move ICP from the canister's own default account (same source as
  // `dev_faucet_token`) into the treasury subaccount, so the faucet floor gate
  // passes and grants have ICP to draw from.
  dev_fund_treasury : (nat64) -> (Result);
  // Local-dev: give the token to the caller (visualise "owned by me").
  dev_give_course : (nat64) -> (Result);
  // Local-dev: add a course to the caller's favourites (real add path; capped/dedup).
  dev_grant_favorite : (nat64) -> (Result);
  // Local-dev: grant the caller `count` lottery tickets in the current round so
  // the UI can be demoed with a non-empty holding without staking. Local only.
  dev_grant_lottery_tickets : (nat64) -> (Result_1);
  // Local-dev: wipe the proposals and their vote/commitment journals, then
  // reseed the mock set — so you can vote on fresh proposals again. Returns
  // the number of proposals seeded. Never available off the local network.
  dev_reset_proposals : () -> (Result_1);
  // Local-dev: force a settlement now regardless of the period clock.
  dev_run_early_adopter_settlement : () -> (Result);
  // Local-dev: hold a drawing immediately. `force_win` rigs the winning ticket
  // to index 0 so the full payout path can be exercised without 1-in-292M luck.
  dev_run_lottery_draw : (bool) -> (Result);
  // Local-dev: run one staking sweep pass immediately (instead of waiting for
  // the 5-minute timer).
  dev_run_staking_sweep : () -> (Result);
  // Local-dev only (admin): make the table playable + lively. Grants the CALLER a
  // dev stake (so they have chips to play), then seeds six auto-pilot bots with
  // dev stakes and varied builtin strategies so every round has company, plus a
  // little opening chatter. Bots react to outcomes via `crash_bot_chatter`.
  dev_seed_casino_play : () -> (Result_2);
  // Local-dev: mint up to `count` varied courses (tops up toward `count`, bounded).
  dev_seed_courses : (nat32) -> (Result_5);
  dev_seed_drafts : (nat64, nat32) -> (Result);
  dev_seed_farmer : (nat32, text) -> (Result_4);
  // Local-dev: insert mock faucet grants so the "Recent grants" list renders.
  dev_seed_faucet_grants : (nat32) -> (Result);
  // Local-dev: replace all featured rows with `active` live + `pending` pending
  // placements, referencing the first approved listings, so every hero/admin
  // state can be previewed without paying. Local only.
  dev_seed_featured_dapps : (nat64, nat64) -> (Result_1);
  // Local-dev: seed `count` synthetic unique ticket-holders (1 ticket each) in the
  // current round so the minimum-players gate and the players progress bar can be
  // exercised without real users. Returns the new unique-holder count. Local only.
  dev_seed_lottery_holders : (nat64) -> (Result_1);
  // Local-dev: seed a varied set of mock payout records for the caller so the
  // Profile page has realistic data. No-op if the caller already has payouts.
  dev_seed_payouts : () -> (Result);
  // Local-dev: insert an Active pool neuron with an explicit voting power, so we
  // can seed mock pool members (with varied VP) for UI testing. Rejected on
  // mainnet (ledger canister ID check). Never callable by anonymous.
  dev_seed_pool_neuron : (nat64, nat64) -> (Result);
  // Local-dev: seed `n_threads` threads (each with `n_comments` comments) on a
  // proposal, no fee, for previewing the UI. Local only.
  dev_seed_threads : (nat64, nat64, nat64) -> (Result_1);
  // Local-dev: force a course's for-sale state (same fields list/delist set).
  dev_set_course_sale : (nat64, opt nat64) -> (Result);
  // Local-dev: jump the page to a significant preset state (VISUAL ONLY —
  // model state is rewritten, ledger balances are not, so claims won't pay).
  // 0 = fresh & open (empty everything), 1 = open with members + a varied
  // 6-month history + a claimable share for the caller, 2 = membership
  // closed (same history plus the 2,000+ ICP month that latched it).
  dev_set_early_adopter_preset : (nat8) -> (Result);
  // Local-dev: pin a course in the featured slot WITHOUT a real ck-token bid.
  dev_set_featured : (nat64) -> (Result);
  // Local-dev: set a course's play_count (and cosmetic tickets_distributed).
  dev_set_play_count : (nat64, nat64) -> (Result);
  // Local-dev: insert a finished winning-draw record with the CALLER as the winner
  // so an admin can preview the "you won" banner UI. Cosmetic only — NO ICP is
  // transferred (payout/cycle blocks are pre-set so the payout sweep treats it as
  // already settled). Local only. Returns the synthetic draw id.
  dev_simulate_lottery_win : () -> (Result_1);
  // Local-dev: move a token to a mock/other owner (visualise "owned by someone").
  dev_simulate_sale : (nat64, principal) -> (Result);
  distribute_pool_rewards : (nat64) -> (Result);
  // Stake into the platform's 2-year early adopter neuron. PERMANENT: there is
  // no unstake path, by design — the principal can never be withdrawn.
  early_adopter_stake : (nat64) -> (Result);
  finalize_pool_registration : (nat64) -> (Result);
  // Fund a project with deposited tokens — 100% goes to the protocol
  // treasury (which pays for the project's execution). Same minimums as
  // upvotes (value-aligned across tokens).
  fund_project : (nat64, IdeaToken, nat64) -> (Result);
  // The caller's deposit address: the account identifier of their default
  // (sub-account = 0) ICP account. Fund this to participate.
  get_account_id : () -> (text) query;
  // On-chain hole overrides (built-in defaults live in the frontend; only
  // admin-edited holes are stored). Public so the game can merge at load.
  get_arcade_course : () -> (vec ArcadeCourseEntry) query;
  // Price the $1 customization in `token` at the live oracle rate and lock
  // it for the caller for 15 minutes (same pattern as Explorer quotes).
  get_arcade_customize_quote : (IdeaToken) -> (Result_6);
  // The caller's deposit account for arcade fees. Fund it on the ICP ledger
  // with `customize_fee + 0.0001 ICP`, then call `customize_character`.
  get_arcade_deposit_address : () -> (LedgerAccount) query;
  get_arcade_info : () -> (ArcadeInfo) query;
  // Top 100 for one game: fewest strokes, fastest time, earliest submission.
  get_arcade_leaderboard : (text) -> (vec ArcadeLeaderboardRow) query;
  // Returns a page of audit log entries. offset + limit are capped at 10,000
  // to prevent a single query from exhausting cycle budgets.
  get_audit_log : (nat64, nat64) -> (vec AuditLogEntry) query;
  get_caller_principal : () -> (principal) query;
  // Chat messages with id > `since_id` (0 = the whole ring), oldest→newest.
  get_casino_chat : (nat64) -> (vec ChatMsgView) query;
  get_casino_stats : () -> (CasinoStatsView) query;
  // Quote the comment fee ($0.25 USD) in `token`. Shares DISCUSSION_QUOTES with
  // the thread quote; the op-specific `usd_total_e8s` distinguishes them.
  get_comment_quote : (IdeaToken) -> (Result_6);
  get_config : () -> (Config) query;
  get_course : (nat64) -> (opt CourseCard) query;
  get_course_data : (nat64) -> (opt blob);
  get_course_rating_summary : (nat64) -> (CourseRatingSummary) query;
  // Last `n` finished rounds (newest first), each with its revealed seed for the
  // client-side verify dialog (C14).
  get_crash_history : (nat64) -> (vec CrashHistoryItem) query;
  // The live round (curve drawn client-side from `run_started_at`). The crash
  // point and seed are redacted until the round crashes — no result-aware betting.
  get_crash_round : () -> (CrashRoundView) query;
  get_cycle_balance : () -> (nat64) query;
  get_deposit_address : (nat64) -> (LedgerAccount) query;
  // The caller's per-proposal-independent discussion fee escrow account. Fund it
  // on the chosen token's ledger, then call `start_thread` / `add_comment`.
  get_discussion_deposit_address : () -> (LedgerAccount) query;
  // The caller's deposit account for becoming (or topping up as) a
  // early adopter. Fund it with `amount + 0.0001 ICP`, then call
  // `early_adopter_stake(amount)`.
  get_early_adopter_deposit_address : () -> (LedgerAccount) query;
  get_early_adopter_info : () -> (EarlyAdopterInfo) query;
  // Local-dev: where to send mock yield (the neuron's maturity inbox).
  get_early_adopter_yield_inbox_address : () -> (LedgerAccount) query;
  get_eligibility : () -> (EligibilityInfo) query;
  // The caller's deposit account for Explorer listing fees. Fund it on the
  // quoted token's ledger with `quote.amount` + one transfer fee, then call
  // `submit_dapp`.
  get_explorer_deposit_address : () -> (LedgerAccount) query;
  get_explorer_info : () -> (ExplorerInfo) query;
  // Price `days` of visibility in `token` at the live USD rate and lock that
  // price for the caller for 15 minutes. An update (not a query) because the
  // mainnet path may refresh the rate via the XRC.
  get_explorer_quote : (IdeaToken, nat64) -> (Result_6);
  // On-demand generation: the owner viewing a Farmer triggers (throttled to max
  // 1/day inside the Farmer) a fresh generation, then returns its retained drafts.
  // Dev-seed Farmers (no canister) just return the seeded mock drafts so the UI works.
  get_farmer_drafts : (nat64, nat64) -> (Result_7);
  // Read-only companion to `get_farmer_drafts`: returns the Farmer's currently
  // STORED drafts WITHOUT triggering generation (no Gemini outcall, no throttle
  // consumed). The UI calls this first to paint cached drafts instantly, then calls
  // `get_farmer_drafts` in the background to (maybe) refresh — so a slow or failed
  // generation never blanks the list the owner already has.
  get_farmer_drafts_cached : (nat64, nat64) -> (Result_7);
  // The owner's live Farmer status: cycles remaining, days of budget left, next
  // generation. Proxies to the Farmer canister for the live cycle balance.
  get_farmer_status : (nat64) -> (Result_8);
  get_faucet_stats : () -> (FaucetStats) query;
  // Public faucet status for `(caller, canister_id)`. `canister_id == None` gives
  // flag + params + the caller's G2/G3 standing (no canister-specific gate).
  get_faucet_status : (opt principal) -> (FaucetStatus) query;
  // Anonymous-OK query: the active featured set (joined to listings) + slot/price
  // info. The hero picks one of `active` at random client-side per page load.
  get_featured_dapps : () -> (FeaturedInfo) query;
  get_featured_deposit_address : () -> (LedgerAccount) query;
  // Quote `days` of featured placement in `token` at the live USD rate; locks the
  // price for the caller for 15 minutes (separate from the listing quote).
  get_featured_quote : (IdeaToken, nat64) -> (Result_6);
  get_featured_slot : () -> (opt FeaturedSlot) query;
  // App-wide totals: TVL (sum of `total_committed_e8s` over open/met proposals),
  // cumulative ICP burned (sum of `icp_burned_e8s` over all `VoteRecord`s), and
  // the count of distinct NNS proposals this app has cast a vote on.
  // 
  // Pure read over in-memory maps — `O(n)` over proposals + votes. Safe for any
  // reasonable n; documented in the task.
  get_global_stats : () -> (GlobalStats) query;
  // Dashboard data: the rolling 14-day ICP total-supply history, ascending by time
  // → (timestamp_ns, supply_e8s).
  get_icp_supply_history : () -> (vec record { nat64; nat64 }) query;
  get_idea_board_info : () -> (IdeaBoardInfo) query;
  // The caller's deposit account for upvoting `idea_id`. The same subaccount
  // is used on every token's ledger — fund it on the ledger of the token you
  // intend to upvote with, then call `upvote_idea`.
  get_idea_deposit_address : (nat64) -> (LedgerAccount) query;
  // The caller's deposit account for the idea-posting fee. Quote with
  // `get_idea_post_quote(token)`, fund this account on that token's ledger with
  // `quote.amount + token fee`, then call `post_idea`.
  get_idea_post_deposit_address : () -> (LedgerAccount) query;
  // Quote the $0.05 idea-post fee in `token` at the live XRC rate; locks the price
  // for the caller for 15 minutes. ICP is burned 100%; other tokens → the treasury.
  get_idea_post_quote : (IdeaToken) -> (Result_6);
  // Cached public stats for the community leader neuron (voting power, dissolve
  // delay, stake). `updated_at == 0` means not yet fetched.
  get_leader_neuron_info : () -> (LeaderNeuronInfo) query;
  // Update (not query): reads the live pot balance from the ledger. Safe for
  // anonymous callers — `my_tickets` is simply 0.
  get_lottery_info : () -> (LotteryInfo);
  // The lottery prize-pot account. Anyone may top it up (sweeten the pot) by
  // transferring ICP here — the funds become part of the next jackpots.
  get_lottery_pot_address : () -> (LedgerAccount) query;
  get_mint_deposit_address : () -> (LedgerAccount) query;
  get_my_autopilot : () -> (opt AutopilotState) query;
  get_my_casino : () -> (MyCasinoView) query;
  get_my_commitments : () -> (vec Commitment) query;
  // The caller's own featured applications (any state), joined to their listings.
  get_my_featured : () -> (vec FeaturedView) query;
  get_my_licenses : () -> (vec License) query;
  // The caller's payout history, newest first (capped).
  get_my_payouts : () -> (vec Payout) query;
  get_my_pool_neuron : () -> (opt PoolNeuron) query;
  get_my_stake : () -> (UserStakeInfo) query;
  // The caller's full transaction history — spends AND payouts. Out legs come
  // from the audit log (ICP flows: commits, idea posts, pool fees, stake
  // lockups) plus the token-typed upvote/funding journals; In legs are the
  // payout records. Newest first, capped.
  get_my_transactions : () -> (vec TransactionRecord) query;
  get_my_twitter_handle : () -> (opt text) query;
  get_pool_info : () -> (PoolInfo) query;
  // The caller's deposit account for funding `project_id`. Fund it on the
  // chosen token's ledger with `amount + fee`, then call `fund_project`.
  get_project_deposit_address : (nat64) -> (LedgerAccount) query;
  get_proposal : (nat64) -> (opt Proposal) query;
  get_registration_address : () -> (LedgerAccount) query;
  // The caller's stake-escrow subaccount. Fund it with amount + 0.0001 ICP fee,
  // then call `stake(amount)`.
  get_stake_deposit_address : () -> (LedgerAccount) query;
  get_staking_pool_info : () -> (StakingPoolInfo) query;
  get_thread : (nat64) -> (opt Thread) query;
  // Cheap count for the proposal card badge ("See open threads (N)").
  get_thread_count : (nat64) -> (nat64) query;
  // Quote the thread-start fee ($1 USD) in `token` at the live rate; locks the
  // price for the caller for 15 minutes.
  get_thread_quote : (IdeaToken) -> (Result_6);
  get_treasury_balance : () -> (BalanceResult);
  // The treasury's ledger account — deposit ICP here to fund it directly
  // (admin top-ups, external donations). Not secret: it's just the backend
  // canister plus the fixed treasury subaccount.
  get_treasury_deposit_address : () -> (LedgerAccount) query;
  // Cached USD rates for every supported token — what the UI uses to render
  // dollar thresholds and conversion previews. Same source the canister uses
  // for valuations (XRC-cached on mainnet, admin/static locally).
  get_usd_rates : () -> (vec TokenUsdRate) query;
  get_xfarm_deposit_address : () -> (LedgerAccount) query;
  get_xfarm_info : () -> (XFarmInfo) query;
  // USD tier price → ICP at the cached XRC rate; lock the quote for the caller
  // for 15 minutes (mirrors get_explorer_quote). An update (not a query) because
  // the mainnet path may refresh the rate via the XRC.
  get_xfarm_quote : (nat32, nat32) -> (Result_9);
  get_xfarm_tiers : () -> (vec FarmerTier) query;
  is_favorite : (nat64) -> (bool) query;
  list_active_proposals : () -> (vec Proposal) query;
  list_all_proposals : () -> (vec Proposal) query;
  // Every thread across all proposals (for the full Discussions page; the client
  // groups by `proposal_id`). Sorted by net score then newest; `my_vote` filled.
  list_all_threads : () -> (vec Thread) query;
  // Comments on a thread, newest first, with the caller's vote filled in.
  list_comments : (nat64) -> (vec Comment) query;
  // PB-307 A2/B3: put a (live-owned) course up for fixed-price sale. Sets
  // `for_sale=true` + `price_e8s`. Owner-gated against the LIVE owner
  // (`icrc7_owner_of`), not the cached row. Keeps the course `listed` (playable).
  list_course_for_sale : (nat64, nat64) -> (Result);
  list_course_reviews : (nat64, nat64, nat64) -> (vec Rating) query;
  list_crash_strategies : () -> (vec CrashStrategy) query;
  // All live (approved, unexpired) listings: admin-curated first in curation
  // order, then community listings in approval order.
  list_dapps : () -> (vec DappListing) query;
  // Settlement history, oldest first (chart data: yield per month + share
  // pool balance after each settlement).
  list_early_adopter_rounds : () -> (vec EarlyAdopterRound) query;
  // The full early adopter roster, largest stake first.
  list_early_adopters : () -> (vec EarlyAdopterPublic) query;
  // Recent faucet grants, most-recent-first, capped at 25 — backs the public
  // transaction list. Each `block_index` is the on-chain ICP-ledger tx.
  list_faucet_grants : (nat32) -> (vec FaucetGrant) query;
  // All flags the canister knows about (known defaults merged with any extra
  // admin-created keys). Public so anonymous viewers can hide gated UI.
  list_feature_flags : () -> (vec FeatureFlag) query;
  // All live ideas, newest first. Time-expired ideas are omitted even before
  // the sweep deletes them, so the UI never shows a dead idea.
  list_ideas : () -> (vec Idea) query;
  // Most recent drawings, newest first (capped at 50).
  list_lottery_draws : () -> (vec LotteryDraw) query;
  list_marketplace : (opt MarketKind) -> (vec Listing) query;
  list_marketplace_courses : (MarketplaceFilter) -> (MarketplacePage) query;
  // The caller's own submissions in every state — lets the UI show "pending
  // admin approval" and time remaining.
  list_my_dapp_submissions : () -> (vec DappListing) query;
  list_my_farmers : () -> (vec Farmer) query;
  list_my_favorite_courses : () -> (vec CourseCard) query;
  list_my_pending_unstakes : () -> (vec PendingUnstake) query;
  list_my_threads : () -> (vec Thread) query;
  // Admin: the approval queue, oldest first.
  list_pending_dapps : () -> (vec DappListing) query;
  // Admin: pending featured applications awaiting review.
  list_pending_featured : () -> (vec FeaturedView) query;
  // All projects, newest first. `raised_usd_e8s` is computed per call from the
  // per-token raised pots at the cached USD rate.
  list_projects : () -> (vec Project) query;
  // The last 10 winning drawings, newest first — the public winners board.
  list_recent_winners : () -> (vec LotteryDraw) query;
  // List a crash strategy (you authored) on the shared marketplace. $1–$500.
  list_strategy : (nat64, nat64, text) -> (BalanceResult);
  // Threads on a proposal, sorted by net score (upvotes − downvotes), then newest.
  // `my_vote` is filled in Phase 2 (currently None).
  list_threads : (nat64) -> (vec Thread) query;
  list_vote_history : () -> (vec VoteRecord) query;
  list_yield_distributions : () -> (vec YieldDistribution) query;
  // Merge a still-dissolving unstake neuron back into any tier pool — the
  // "changed my mind" path. The dissolve is stopped, the child's stake (minus
  // one ledger fee charged by governance on merge) joins the chosen tier, and
  // the user's stake there resumes earning weight and tickets immediately.
  // 
  // The platform's main neurons are merge TARGETS only, never sources: the
  // source must be a child tracked in PENDING_UNSTAKES, and is additionally
  // checked against every platform neuron id before any governance call.
  merge_unstake : (nat64, StakeTier) -> (Result);
  mint_course_nft : (blob, text) -> (Result_10);
  my_favorite_ids : () -> (vec nat64) query;
  notify_top_up : (NotifyTopUpArgs) -> (NotifyTopUpResult);
  // Post to the global casino chat (signed-in only, 200 chars, 1 msg/5 s).
  // Rendered as plain text by the UI — no markup, no links: zero injection
  // surface. Muted users' posts are silently accepted but only echoed to them.
  post_casino_chat : (text) -> (BalanceResult);
  post_idea : (text, text, text, IdeaToken) -> (BalanceResult);
  rate_course : (nat64, nat8, opt text) -> (Result);
  // Withdraw the caller's remaining balance from one of their pay-first
  // deposit subaccounts. These accounts are funded right before a paid
  // action; if that action then fails — expired quote, listing quota, closed
  // membership, a guard rejection, an overpayment, or (Discussion) the proposal
  // settling before the comment landed — the deposit would otherwise be
  // stranded with no recovery path. Only ever touches the caller's own derived
  // subaccount, and the shared CallerGuard makes it mutually exclusive with the
  // paid actions (every consume method already takes CallerGuard).
  // Deliberately NOT feature-flag-gated: stranded funds must stay recoverable
  // even after a kill switch.
  // 
  // `key` is the proposal_id for `Commitment` and the project_id for `Project`
  // (required for those; `KEY_REQUIRED` if missing). The per-principal kinds
  // ignore it.
  reclaim_escrow : (EscrowKind, IdeaToken, opt nat64) -> (BalanceResult);
  record_hole_event : (nat64, nat8) -> (Result_11);
  // Count a detail-view open (signed-in users only — anonymous ingress is
  // already rejected by inspect_message). Drives "most viewed" sorting.
  record_idea_view : (nat64) -> (Result);
  refresh_course_listing : (nat64) -> (Result);
  refund_registration : () -> (Result);
  // Self-service: refund my own stranded x-farm escrow deposit.
  refund_xfarm_escrow : () -> (BalanceResult);
  // Proof-of-control registration. The TARGET canister calls this on itself, so
  // `get_caller()` (the message's authenticated caller) IS the canister to
  // register. Cheap, network-free rejects for obviously-bad principals.
  register_faucet_canister : (principal) -> (Result);
  remove_admin : (principal) -> (Result);
  // RENEW: pay again to extend an existing (Active) Farmer's lifespan. Reuses the
  // create money path — 10% → treasury, 90% → CMC topup to the EXISTING Farmer
  // canister — then calls the Farmer's `extend(add_budget_cycles, add_days)` to bump
  // the budget + duration and re-arm the burn timer. The owner gets a fresh quote for
  // the Farmer's tier first (frontend calls get_xfarm_quote). A depleted/swept Farmer
  // (no canister) can't be renewed → create a new one.
  // 
  // C2 trapped-fund fix (2026-06-20): the CMC leg now journals `burn_block_index` +
  // clears `cmc_notified` BEFORE the notify call (mirrors `create_farmer`), so a
  // transient notify failure no longer strands the 90% ICP at the CMC — `xfarm_sweep`
  // re-notifies the journaled block and recovers it as cycles. `CMC_REFUNDED` drops
  // the block (the CMC sent the ICP back to the escrow) and the auto-refund wrapper
  // returns it. Like `create_farmer`, ANY failure auto-refunds the escrow: pre-money
  // failures refund the full deposit; post-money failures find the escrow drained →
  // refund no-ops (the CMC leg is journaled, so the sweep recovers those funds).
  // 
  // NOTE: the money legs here are NOT guarded the way create's are — the Farmer's
  // `treasury_block` / `burn_block_index` / `cmc_notified` fields are reused from
  // create and can't cleanly distinguish "this renew's block" from "create's block"
  // without per-renew struct fields. So a renew always re-runs the treasury + CMC
  // transfers (overwriting the historical create blocks). This matches the pre-fix
  // behavior; the only change is the journaling that lets the sweep recover a notify
  // failure. The retry-after-extend-failure double-charge this implies is a known
  // limitation documented in docs/escrow-fix-review-2026-06-20.md (the proper fix is
  // a per-renew epoch field; deferred — extend failures are rare, the Farmer canister
  // is controller-owned and the call is local).
  renew_farmer : (nat64, nat32) -> (Result_4);
  // Called by a Farmer canister when its cycle balance hits the stop-floor (D2).
  // Only the Farmer's own canister may report. Sets Depleted so the sweep reaps it.
  report_depleted : (nat64, nat64) -> (Result);
  // Set (or clear, with an empty string) the caller's X handle. A leading @
  // is stripped; X's own rules apply (1–15 chars, [A-Za-z0-9_]).
  set_twitter_handle : (text) -> (Result);
  stake : (nat64, StakeTier) -> (Result);
  // Start auto-pilot with a strategy the caller may use (builtin / owned / licensed).
  start_autopilot : (nat64) -> (Result);
  // Pure synchronous update — no `raw_rand`, no inter-canister await (PB-306 A2).
  start_play_session : (nat64) -> (Result_12);
  // Start a discussion thread on `proposal_id` for the $1 fee (deposited on
  // get_discussion_deposit_address, quoted via get_thread_quote). ICP burns to
  // backend cycles; non-ICP goes to the treasury.
  start_thread : (nat64, text, text, IdeaToken) -> (BalanceResult);
  stop_autopilot : () -> (Result);
  // Submit a finished round. Requires full access (the hole-1 preview can't
  // produce a 9-hole score). Insert-if-better per (game, player); returns the
  // caller's resulting 1-based rank on that game's board.
  submit_arcade_score : (text, nat64, blob) -> (Result_5);
  // Submit a community listing. Requires a fresh quote for the same token +
  // days (get_explorer_quote) and the quoted amount (+ one ledger fee)
  // deposited on get_explorer_deposit_address. The payment moves to the
  // treasury immediately; the listing stays Pending — invisible to the
  // public — until an admin approves it. Rejection refunds from the treasury.
  submit_dapp : (text, text, text, IdeaToken, nat64, vec text, bool) -> (
      BalanceResult,
    );
  // Toggle a course in the caller's favorites. Returns the NEW state
  // (`Ok(true)` = now favorited, `Ok(false)` = now removed) so the frontend can
  // reconcile its optimistic flip without a follow-up read (PB-311 B2).
  toggle_favorite_course : (nat64) -> (Result_13);
  unregister_leader_neuron : (nat64) -> (Result);
  // Split `amount_e8s` off the tier's pool neuron and start dissolving it; the
  // sweep disburses to the caller's wallet once the tier's full term passes.
  // Returns the pending-unstake id. The user nets amount − 0.0002 ICP (split +
  // disburse fees).
  unstake : (nat64, StakeTier) -> (BalanceResult);
  // Upvote an idea — FREE. No crypto is collected; one upvote per user per idea
  // (mirrors `record_idea_view`). Bumps the idea's count and resets its 30-day
  // expiry clock.
  upvote_idea : (nat64) -> (Result);
  // Provably-fair verification for a finished round (C14): returns the seed, the
  // recomputed crash point, and the chain-link proof back to the genesis terminal.
  verify_crash_round : (nat64) -> (Result_14) query;
  // Up/down vote a comment (free, toggle). Comment votes earn NO reward.
  vote_comment : (nat64, VoteDir) -> (Result);
  // Up/down vote a thread (free, toggle). A NEW upvote may mint the author a
  // lottery ticket (maybe_award_thread_upvote).
  vote_thread : (nat64, VoteDir) -> (Result);
  wallet_receive : () -> (Result);
  whoami : () -> (Result_15);
}
