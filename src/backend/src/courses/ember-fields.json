{
  "format": "proof-of-burn/minigolf-course@1",
  "name": "Ember Fields",
  "description": "A friendly warm-up nine: open greens, gentle bunkers, one windmill. Par 25.",
  "instructions": {
    "summary": "Build each of the 9 holes from its ASCII layout grid. Every row in a layout must be the same length, and each hole must contain exactly one T (tee) and one C (cup). The app rasterizes each character into a terrain cell and compiles the result into a playable hole.",
    "legend": {
      ".": "out of bounds (solid)",
      "#": "wall (raised block, ball bounces off)",
      "g": "green (normal fairway)",
      "r": "rough (extra friction)",
      "s": "sand (heavy friction)",
      "w": "water (penalty stroke, ball returns to pre-shot spot)",
      "^": "slope accelerating the ball north (up)",
      "v": "slope accelerating the ball south (down)",
      ">": "slope accelerating the ball east (right)",
      "<": "slope accelerating the ball west (left)",
      "o": "post (round bumper)",
      "T": "tee (ball start, sits on green)",
      "C": "cup (hole target, sits on green)"
    },
    "windmills": "Optional per-hole rotating bars: x and y are the pivot in cell units (fractions allowed), lengthCells is the full arm length in cells, speed is angular velocity in radians per second (negative spins the other way)."
  },
